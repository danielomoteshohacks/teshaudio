---
/**
 * TrackRow
 *
 * One track in a list: play button, artwork, title, metadata and duration.
 * On phones it is a compact two-line row; from 48rem the metadata spreads into
 * aligned columns (roles, genre, year, duration) like a tracklist.
 * The player marks the active row with data-current so it can be highlighted.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PlayButton from './PlayButton.astro';
import Badge from './Badge.astro';
import { formatDuration, roleLabel, spokenDuration } from '../lib/format';

interface Props {
  track: CollectionEntry<'tracks'>;
  index?: number;
  showCredits?: boolean;
}

const { track, index, showCredits = false } = Astro.props;
const { title, roles, year, genre, durationSeconds, artwork, credits, testAudio } = track.data;
const roleText = roles.map((role) => roleLabel[role]).join(', ');
---

<div class="track" data-track-row>
  {index !== undefined && <span class="track__index" aria-hidden="true">{String(index).padStart(2, '0')}</span>}
  <PlayButton track={track} />

  <div class="track__art" aria-hidden="true">
    {
      artwork ? (
        <Image src={artwork} alt="" width={112} height={112} />
      ) : (
        <span class="track__art-fallback">{title.charAt(0)}</span>
      )
    }
  </div>

  <div class="track__main">
    <p class="track__title">
      {title}
      {testAudio && <Badge tone="neutral">Test audio</Badge>}
    </p>
    <p class="track__meta">
      {[roleText, genre].filter(Boolean).join(' · ')}
      <span class="track__meta-year"> · {year}</span>
    </p>
  </div>

  <p class="track__year">{year}</p>
  <p class="track__duration">
    <span aria-hidden="true">{formatDuration(durationSeconds, { total: true })}</span>
    <span class="visually-hidden">{spokenDuration(durationSeconds)}</span>
  </p>

  {
    showCredits && credits.length > 0 && (
      <details class="track__credits">
        <summary>Credits</summary>
        <dl>
          {credits.map((credit) => (
            <div>
              <dt>{credit.role}</dt>
              <dd>{credit.name}</dd>
            </div>
          ))}
        </dl>
      </details>
    )
  }
</div>

<style>
  .track {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .track__index {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .track__art {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border-radius: var(--radius-sm);
    /* Fallback tile: a quiet accent-tinted gradient instead of a grey box. */
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--color-accent) 30%, var(--color-surface-raised)),
      var(--color-surface-raised)
    );
  }

  .track__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .track__art-fallback {
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  .track__main {
    min-width: 0;
  }

  .track__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .track__meta,
  .track__year,
  .track__duration {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .track__meta {
    margin-top: var(--space-1);
  }

  .track__year {
    display: none;
  }

  .track__duration {
    text-align: right;
  }

  /* The playing row picks up the accent so it is easy to find in a list. */
  .track[data-current] .track__title {
    color: var(--color-accent);
  }

  .track__credits {
    grid-column: 1 / -1;
    font-size: var(--step--1);
  }

  .track__credits summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .track__credits dl {
    display: grid;
    gap: var(--space-2);
  }

  .track__credits div {
    display: flex;
    gap: var(--space-3);
  }

  .track__credits dt {
    min-width: 8rem;
    color: var(--color-text-muted);
  }

  .track__credits dd {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .track {
      grid-template-columns: 2rem auto auto minmax(0, 1fr) 4rem 4rem;
    }

    .track__index,
    .track__year {
      display: block;
    }

    .track__meta-year {
      display: none;
    }
  }
</style>
