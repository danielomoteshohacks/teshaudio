---
/**
 * WorkWithMe: an invitation to collaborate, in Tesh's words (site.ts).
 *
 * variant:
 *   "full"   Home. A panel in its own faintly cobalt-tinted surface tone.
 *            Desktop (1024px+): label, heading and intro on the left; the
 *            four areas on the right in a 2x2 grid divided by hairlines
 *            (no boxes); the closing line and buttons underneath at full
 *            width. Tablet (768px+): heading and intro above the 2x2 grid.
 *            Phones: one list with hairline dividers.
 *   "short"  About. Label, heading, intro and the buttons only.
 *
 * It should read as a warm invitation, not a sales page: no prices, no
 * icons, no "packages"; the numbers are only there to give the eye a path.
 */
import Button from './Button.astro';
import { site, workWithMe as copy } from '../lib/site';

interface Props {
  variant?: 'full' | 'short';
}

const { variant = 'full' } = Astro.props;
const full = variant === 'full';
const github = site.socials.find((s) => s.label === 'GitHub');
const headingId = `work-with-me-${variant}`;
---

<section class:list={['invite', `invite--${variant}`]} aria-labelledby={headingId} data-reveal>
  <div class="invite__head">
    <p class="invite__label">{copy.label}</p>
    <h2 id={headingId} class="invite__heading">{copy.heading}</h2>
    <p class="invite__intro">{copy.intro}</p>
  </div>

  {
    full && (
      <ol class="invite__areas" role="list" data-reveal-group>
        {copy.areas.map((area, i) => (
          <li class="area" data-reveal-item>
            <p class="area__number" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="area__title">{area.title}</h3>
            <p class="area__body">{area.body}</p>
          </li>
        ))}
      </ol>
    )
  }

  <div class="invite__close">
    {full && <p class="invite__closing">{copy.closing}</p>}
    <div class="invite__actions">
      {site.email && <Button size="lg" href={`mailto:${site.email}`}>{copy.emailLabel}</Button>}
      {
        github && (
          <Button size="lg" variant="secondary" href={github.url} rel="me noopener">
            {copy.githubLabel}
          </Button>
        )
      }
    </div>
  </div>
</section>

<style>
  .invite {
    display: grid;
    gap: clamp(var(--space-10), 5vw, var(--space-16));
  }

  /* Home: a panel with its own surface tone, a breath of cobalt in the
     page's surface colour, so it reads as a different room from the work
     above it and the band below. */
  .invite--full {
    padding: clamp(var(--space-8), 5vw, var(--space-20)) clamp(var(--space-5), 5vw, var(--space-20));
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    background-color: color-mix(in oklab, var(--color-bg-2) 95%, var(--color-accent));
  }

  /* About: no panel, a section like the others on the page. */
  .invite--short {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  .invite__head {
    display: grid;
    align-content: start;
    gap: var(--space-5);
  }

  .invite__label {
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-2);
  }

  .invite__heading {
    max-width: 12em;
    font-size: var(--step-invite);
    font-weight: var(--weight-display);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  .invite__intro {
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: var(--leading-body);
    color: var(--color-text-2);
  }

  /* ----- The four areas: one list on phones, hairline-divided ----- */
  .invite__areas {
    display: grid;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line-strong);
  }

  .area {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding-block: var(--space-6) var(--space-8);
    border-bottom: 1px solid var(--color-line);
  }

  .area__number {
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }

  .area__title {
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tight);
  }

  .area__body {
    max-width: 30rem;
    color: var(--color-text-2);
  }

  /* ----- Closing line and buttons, full width ----- */
  .invite__close {
    display: grid;
    gap: var(--space-6);
  }

  .invite--full .invite__close {
    padding-top: clamp(var(--space-6), 3vw, var(--space-10));
    border-top: 1px solid var(--color-line);
  }

  .invite__closing {
    max-width: 36rem;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-text);
  }

  .invite__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 29.99rem) {
    .invite__actions > :global(*) {
      flex: 1 1 auto;
    }
  }

  /* Tablet up: the areas become a 2x2 grid. Hairlines between the cells,
     never round them: a top rule on the second row, a left rule on the
     second column. */
  @media (min-width: 48rem) {
    .invite__areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-top: 0;
    }

    .area {
      padding: var(--space-8) var(--space-8) var(--space-10) 0;
      border-bottom: 0;
    }

    .area:nth-child(even) {
      padding-left: var(--space-8);
      padding-right: 0;
      border-left: 1px solid var(--color-line);
    }

    .area:nth-child(n + 3) {
      border-top: 1px solid var(--color-line);
    }

    .invite--full .invite__close {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-8);
    }
  }

  /* Desktop: the split. The head on the left, the grid on the right, the
     closing row across the bottom. */
  @media (min-width: 64rem) {
    .invite--full {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(var(--space-12), 6vw, var(--space-24));
    }

    .invite--full .invite__close {
      grid-column: 1 / -1;
    }

    .invite--full .invite__intro {
      font-size: var(--step-0);
      line-height: var(--leading-read);
    }

    .area:nth-child(-n + 2) {
      padding-top: 0;
    }

    /* About: the label and heading on the left, the intro and buttons on
       the right, the same split as the page's other sections. */
    .invite--short {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      column-gap: var(--space-16);
      row-gap: var(--space-8);
    }

    .invite--short .invite__head {
      display: contents;
    }

    .invite--short .invite__label {
      grid-column: 1 / -1;
    }

    .invite--short .invite__heading {
      grid-column: 1;
      font-size: var(--step-4);
    }

    .invite--short .invite__intro {
      grid-column: 2;
      align-self: end;
    }

    .invite--short .invite__close {
      grid-column: 2;
    }
  }
</style>
