---
/**
 * SiteHeader
 *
 * Sticky header: name on the left, primary navigation on the right.
 *
 * Below 1024px the links move into a full-screen menu built on the native
 * Popover API: the browser provides Escape to close, light-dismiss and
 * top-layer stacking, with no JavaScript. Every link navigates to a new page,
 * which renders a fresh header, so the menu is always closed on arrival.
 */
import { nav, site } from '../lib/site';

// The current section stays highlighted on its detail pages too
// (/projects/acoustimorph/ highlights "Work").
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
const isPage = (href: string) => path === href;
---

<header class="header" data-theme="light">
  <div class="header__inner">
    <a class="header__name" href="/" aria-current={path === '/' ? 'page' : undefined}>
      {site.name}
    </a>

    <nav class="header__nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isPage(item.href) ? 'page' : isCurrent(item.href) ? 'true' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="header__menu-button" type="button" popovertarget="site-menu" aria-label="Open menu">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M3 7h14M3 13h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div id="site-menu" class="menu" popover data-theme="light">
    <div class="menu__top">
      <a class="header__name" href="/">{site.name}</a>
      <button
        class="header__menu-button"
        type="button"
        popovertarget="site-menu"
        popovertargetaction="hide"
        aria-label="Close menu"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
    <nav aria-label="Primary">
      <ul class="menu__list">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isPage(item.href) ? 'page' : isCurrent(item.href) ? 'true' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="menu__meta">{site.location}</p>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Translucent with a blur so content scrolling underneath stays faintly
       visible: the header reads as a layer above the page, not a slab. */
    background-color: color-mix(in oklab, var(--color-surface) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(16px);
    -webkit-backdrop-filter: saturate(1.4) blur(16px);
    border-bottom: 1px solid color-mix(in oklab, var(--color-border) 70%, transparent);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    max-width: var(--container-max);
    height: var(--header-height);
    margin-inline: auto;
    padding-inline: var(--container-gutter);
  }

  .header__name {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--step-0);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    text-decoration: none;
  }

  .header__nav {
    display: none;
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-3);
    border-radius: var(--radius-pill);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .header__nav a:hover {
    color: var(--color-text);
    background-color: color-mix(in oklab, var(--color-text) 6%, transparent);
  }

  .header__nav a[aria-current] {
    color: var(--color-text);
  }

  .header__nav a[aria-current='page'] {
    background-color: color-mix(in oklab, var(--color-text) 7%, transparent);
  }

  .header__menu-button {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-inline-end: calc(var(--space-3) * -1);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .header__menu-button:hover {
    background-color: color-mix(in oklab, var(--color-text) 6%, transparent);
  }

  @media (min-width: 64rem) {
    .header__nav {
      display: block;
    }

    .header__inner > .header__menu-button {
      display: none;
    }
  }

  /* ----- Mobile menu (popover) ----- */
  .menu {
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0 var(--container-gutter) var(--space-10);
    border: 0;
    background-color: var(--color-surface);
    color: var(--color-text);
    flex-direction: column;
  }

  .menu:popover-open {
    display: flex;
  }

  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .menu__list {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-8);
    padding: 0;
    list-style: none;
  }

  .menu__list a {
    display: flex;
    align-items: center;
    min-height: 56px;
    font-size: var(--step-3);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    text-decoration: none;
  }

  .menu__list a[aria-current] {
    color: var(--color-accent);
  }

  .menu__meta {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* A short fade and rise as the menu opens; @starting-style gives the
     entry state. Skipped entirely under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .menu {
      transition:
        opacity var(--duration-base) var(--ease-out),
        transform var(--duration-base) var(--ease-out),
        display var(--duration-base) allow-discrete,
        overlay var(--duration-base) allow-discrete;
      opacity: 0;
      transform: translateY(-8px);
    }

    .menu:popover-open {
      opacity: 1;
      transform: none;
    }

    @starting-style {
      .menu:popover-open {
        opacity: 0;
        transform: translateY(-8px);
      }
    }
  }
</style>
