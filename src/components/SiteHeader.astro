---
/**
 * SiteHeader
 *
 * Name on the left; Work, Writing, About and the theme toggle on the right.
 * With only three links the navigation fits on a 320px phone, so there is
 * no menu button to open: everything is one tap away on every screen.
 *
 * The toggle's click handler and saved choice live in the inline script in
 * BaseLayout, which also keeps aria-pressed in sync across navigations.
 */
import { nav, site } from '../lib/site';

// The current section stays marked on its detail pages too
// (/projects/soundstage/ marks "Work").
const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : path.startsWith(href) ? 'true' : undefined);
---

<header class="header">
  <div class="header__inner wrap">
    <a class="header__name" href="/" aria-current={path === '/' ? 'page' : undefined}>
      {site.name}
    </a>

    <nav class="header__nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button class="header__toggle" type="button" data-mode-toggle aria-pressed="false" aria-label="Dark mode">
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
        </svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="3.5" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
          <path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6L16 16M4 16l1.4-1.4M14.6 5.4L16 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Mostly opaque, so text never shows through, with a light blur for the
       little that does: it reads as a layer, not a slab. */
    background-color: color-mix(in oklab, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--header-height);
  }

  .header__name {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--step-0);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    text-decoration: none;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .header__nav ul {
    display: flex;
    gap: clamp(var(--space-1), 1.5vw, var(--space-4));
    padding: 0;
    list-style: none;
  }

  .header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-2);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--color-text-2);
    text-decoration: none;
  }

  .header__nav a:hover,
  .header__nav a[aria-current] {
    color: var(--color-text);
  }

  .header__toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: calc(var(--space-2) * -1);
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--color-text-2);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .header__toggle:hover {
    color: var(--color-text);
  }

  /* The icon shows what you switch to: a moon in light mode, a sun in dark. */
  .icon-sun,
  :global(:root[data-mode='dark']) .icon-moon {
    display: none;
  }

  :global(:root[data-mode='dark']) .icon-sun {
    display: block;
  }
</style>
