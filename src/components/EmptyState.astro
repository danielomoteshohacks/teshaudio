---
/**
 * EmptyState
 *
 * What a list shows before it has entries. A calm, intentional panel with a
 * short message and an optional next step, so an empty section looks
 * designed rather than broken.
 */
interface Props {
  title: string;
  body?: string;
}

const { title, body } = Astro.props;
---

<div class="empty">
  <svg class="empty__mark" width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
    <circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-dasharray="2 4"></circle>
    <path d="M13 20h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
  </svg>
  <p class="empty__title">{title}</p>
  {body && <p class="empty__body">{body}</p>}
  <slot />
</div>

<style>
  .empty {
    display: grid;
    /* A short message in a full-width box reads as emptier than it is. */
    max-width: 40rem;
    justify-items: start;
    gap: var(--space-3);
    padding: clamp(var(--space-8), 5vw, var(--space-12));
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
  }

  .empty__mark {
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
  }

  .empty__title {
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
  }

  .empty__body {
    max-width: 36rem;
    color: var(--color-text-muted);
  }
</style>
