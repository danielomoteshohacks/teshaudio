---
/**
 * ProjectCard
 *
 * A project as one large link card: status badge, title, summary and tech.
 * The whole card is the link (one focus stop, one big tap target), built on
 * the shared Card component so hover, focus and elevation stay consistent.
 */
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import Badge from './Badge.astro';
import { statusLabel } from '../lib/format';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel: Heading = 'h3' } = Astro.props;
const { title, tagline, summary, status, tech } = project.data;
---

<Card href={`/projects/${project.id}/`}>
  <div class="project">
    <Badge tone={status === 'active' || status === 'shipped' ? 'accent' : 'neutral'} dot>
      {statusLabel[status]}
    </Badge>
    <Heading class="project__title">{title}</Heading>
    {/* The one-line tagline on cards; the full summary lives on the page. */}
    <p class="project__summary">{tagline ?? summary}</p>
    {
      tech.length > 0 && (
        <ul class="project__tech" aria-label="Technology">
          {tech.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
    <span class="project__more" aria-hidden="true">
      View project
      <svg width="14" height="14" viewBox="0 0 14 14"><path d="M3 7h8M7.5 3.5L11 7l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </span>
  </div>
</Card>

<style>
  .project {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    height: 100%;
  }

  .project__title {
    margin-top: var(--space-2);
    font-size: var(--step-2);
  }

  .project__summary {
    color: var(--color-text-muted);
  }

  .project__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-text-muted);
  }

  /* Pushed to the bottom so cards in a row align their call to action. */
  .project__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-4);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
  }

  .project__more svg {
    transition: transform var(--duration-base) var(--ease-out);
  }

  :global(.card:hover) .project__more svg,
  :global(.card:focus-visible) .project__more svg {
    transform: translateX(3px);
  }
</style>
