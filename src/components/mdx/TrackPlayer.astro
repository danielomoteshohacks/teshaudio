---
/**
 * TrackPlayer (MDX): <TrackPlayer track="entry-id" />
 *
 * Embeds one track from the tracks collection in an article. It plays through
 * the persistent mini-player, so reading on to another page does not stop it.
 */
import TrackRow from '../TrackRow.astro';
import { getTrack } from '../../lib/content';

interface Props {
  track: string;
}

const entry = await getTrack(Astro.props.track);
if (!entry) throw new Error(`TrackPlayer: track "${Astro.props.track}" not found`);
---

<div class="embed">
  <TrackRow track={entry} />
</div>

<style>
  .embed {
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-raised);
  }

  /* The row's own bottom hairline is redundant inside a bordered card. */
  .embed :global(.track) {
    border-bottom: 0;
  }
</style>
