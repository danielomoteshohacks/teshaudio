---
/**
 * References (MDX): wraps a numbered Markdown list of sources written in the
 * article itself, under its own "## References" heading, and sets it smaller
 * and quieter than the body, like the notes at the back of a book.
 *
 *   ## References
 *
 *   <References>
 *
 *   1. Author. Title. Publisher, year.
 *
 *   </References>
 */
---

<div class="refs"><slot /></div>

<style>
  .refs :global(ol) {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.6em;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--color-text-2);
  }

  .refs :global(li) {
    margin: 0;
    padding-left: var(--space-1);
    overflow-wrap: anywhere;
  }

  .refs :global(li::marker) {
    color: var(--color-text-3);
    font-variant-numeric: tabular-nums;
  }
</style>
