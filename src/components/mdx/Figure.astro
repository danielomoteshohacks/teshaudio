---
/**
 * Figure (MDX): an image, diagram or embed with a numbered caption.
 *
 *   <Figure src={myImage} alt="..." caption="..." />   image, optimised
 *   <Figure caption="..."><svg>...</svg></Figure>      anything else
 *
 * Images go through Astro's Image component (AVIF/WebP, explicit size), so
 * figures never cause layout shift. Numbering uses a CSS counter.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  caption: string;
}

const { src, alt = '', caption } = Astro.props;
---

<figure class="figure">
  <div class="figure__media">
    {src ? <Image src={src} alt={alt} widths={[480, 720, 1080]} sizes="(min-width: 48rem) 42rem, 100vw" /> : <slot />}
  </div>
  <figcaption class="figure__caption"><span class="figure__label">Figure</span> {caption}</figcaption>
</figure>

<style>
  .figure {
    counter-increment: figure;
    margin-block: var(--space-10);
  }

  .figure__media {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface-raised);
  }

  .figure__media :global(img),
  .figure__media :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .figure__caption {
    margin-top: var(--space-3);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .figure__label {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
  }

  .figure__label::after {
    content: ' ' counter(figure) '.';
  }
</style>
