---
/**
 * Photo (MDX): a royalty-free photo with a credit line.
 *
 *   <Photo file="studio-desk.jpg" alt="..." credit="Name / Unsplash" />
 *
 * Looked up by name in src/assets/photos/ (src/lib/photos.ts). If the file
 * is not there yet, nothing renders: an article can be published before its
 * photos arrive, and never shows a broken image or a stand-in picture.
 * Photos are not numbered like figures, because the text never refers to
 * them; the credit is what the licence and good manners ask for.
 */
import { Image } from 'astro:assets';
import { getPhoto } from '../../lib/photos';

interface Props {
  file: string;
  alt: string;
  /** Printed as "Photo: {credit}", for example "Jane Doe / Unsplash". */
  credit: string;
  creditUrl?: string;
  /** Optional sentence shown before the credit. */
  caption?: string;
  /** Wider than the text column on large screens. */
  wide?: boolean;
}

const { file, alt, credit, creditUrl, caption, wide = false } = Astro.props;
const src = getPhoto(file);
---

{
  src && (
    <figure class:list={['photo', { 'photo--wide': wide }]}>
      <Image
        src={src}
        alt={alt}
        widths={[480, 720, 1080, 1440, 1920]}
        sizes={wide ? '(min-width: 75rem) 56rem, 100vw' : '(min-width: 48rem) 44rem, 100vw'}
        quality={76}
      />
      <figcaption class="photo__caption">
        {caption && <span>{caption} </span>}
        <span class="photo__credit">
          Photo: {creditUrl ? <a href={creditUrl} rel="noopener">{credit}</a> : credit}
        </span>
      </figcaption>
    </figure>
  )
}

<style>
  .photo {
    margin-block: var(--space-12);
  }

  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }

  .photo__caption {
    margin-top: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .photo__credit {
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .photo__credit a {
    color: inherit;
  }
</style>
