---
/**
 * FilterNav
 *
 * Filter pills that are real links to static pages (/projects/status/active/,
 * /writing/kind/essay/). No JavaScript, every filtered view can be shared or
 * bookmarked, and the back button works as expected.
 */
interface Props {
  label: string;
  items: { label: string; href: string; count?: number }[];
}

const { label, items } = Astro.props;
const path = Astro.url.pathname;
---

<nav class="filters" aria-label={label}>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
            {item.label}
            {item.count !== undefined && <span class="filters__count">{item.count}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .filters ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .filters a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .filters a:hover {
    border-color: var(--color-border-strong);
  }

  .filters a[aria-current='page'] {
    border-color: var(--color-text);
    background-color: var(--color-text);
    color: var(--color-surface);
  }

  .filters__count {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }
</style>
