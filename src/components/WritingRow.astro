---
/**
 * WritingRow
 *
 * One entry in a writing list: kind and date in mono, then the title and
 * description. Rows (not cards) because writing lists are scanned by title,
 * and a hairline-separated list reads faster than a grid of boxes.
 */
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate, kindLabel, readingTime } from '../lib/format';

interface Props {
  entry: CollectionEntry<'writing'>;
  headingLevel?: 'h2' | 'h3';
}

const { entry, headingLevel: Heading = 'h3' } = Astro.props;
const { title, description, pubDate, kind } = entry.data;
---

<article class="row">
  <p class="row__meta meta">
    <span>{kindLabel[kind]}</span>
    <span aria-hidden="true">·</span>
    <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime(entry.body)}</span>
  </p>
  <Heading class="row__title">
    <a href={`/writing/${entry.id}/`}>{title}</a>
  </Heading>
  <p class="row__description">{description}</p>
</article>

<style>
  .row {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .row__title {
    font-size: var(--step-2);
  }

  .row__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  /* The link's hit area covers the whole row (a "stretched link"), so the row
     is easy to tap without nesting the description inside the link. */
  .row__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .row__title a:focus-visible {
    outline: none;
  }

  .row:has(a:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .row:hover .row__title a {
    color: var(--color-accent);
  }

  .row__description {
    max-width: var(--measure);
    color: var(--color-text-muted);
  }
</style>
