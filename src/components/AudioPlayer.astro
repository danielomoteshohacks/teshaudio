---
/**
 * AudioPlayer: the persistent bottom mini-player.
 *
 * Why it survives navigation: BaseLayout uses Astro's ClientRouter, which
 * swaps pages without a full reload, and `transition:persist` tells it to
 * move this exact element (and its playing <audio>) into each new page
 * instead of replacing it. Native cross-document view transitions cannot do
 * this, because a full page load always destroys the audio element.
 *
 * How tracks get here: any button with `data-play-track` (see PlayButton.astro)
 * is handled by one delegated click listener, so pages need no script of
 * their own and new pages work automatically.
 *
 * It is a plain custom element, not a framework island: no runtime to ship,
 * and the script below runs once per visit.
 */
import { getImage } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import { site } from '../lib/site';

// Lock-screen artwork when a track has none of its own. Square PNG because
// some phone media controls ignore AVIF and WebP.
const fallbackArtwork = await getImage({
  src: portrait,
  width: 512,
  height: 512,
  fit: 'cover',
  format: 'png',
});
---

<tesh-player
  transition:persist="audio-player"
  data-artist={site.name}
  data-fallback-artwork={fallbackArtwork.src}
>
  <div class="player" data-theme="dark" role="region" aria-label="Audio player" hidden>
    <audio preload="none"></audio>
    <div class="player__inner">
      <button class="player__toggle" type="button" data-action="toggle" aria-label="Play">
        <svg class="icon-play" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M5 3.5v11l9-5.5z" fill="currentColor"></path>
        </svg>
        <svg class="icon-pause" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M5 3.5h2.75v11H5zM10.25 3.5H13v11h-2.75z" fill="currentColor"></path>
        </svg>
      </button>

      <div class="player__body">
        <div class="player__row">
          <p class="player__title" data-title></p>
          <p class="player__time">
            <span data-current>0:00</span><span aria-hidden="true"> / </span><span
              class="visually-hidden"> of </span><span data-duration>0:00</span>
          </p>
        </div>
        <input
          class="player__scrubber"
          type="range"
          min="0"
          max="0"
          step="0.1"
          value="0"
          aria-label="Seek"
          aria-keyshortcuts="K J L"
          data-scrubber
        />
      </div>

      <button class="player__close" type="button" data-action="close" aria-label="Close player">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
    <p class="visually-hidden" aria-live="polite" data-announce></p>
  </div>
</tesh-player>

<script>
  import { formatDuration, spokenDuration } from '../lib/format';

  type Track = { id: string; title: string; src: string; artwork?: string; duration: number };

  const SKIP_SECONDS = 10;

  // The one live player. During a page swap, the incoming page's own
  // <tesh-player> is briefly connected before ClientRouter replaces it with
  // the persisted one. Without this guard that throwaway instance would add a
  // second set of document listeners with empty state, and its handlers would
  // overwrite the real player's state on every navigation.
  let livePlayer: HTMLElement | null = null;

  class TeshPlayer extends HTMLElement {
    private audio!: HTMLAudioElement;
    private panel!: HTMLElement;
    private toggleButton!: HTMLButtonElement;
    private scrubber!: HTMLInputElement;
    private titleEl!: HTMLElement;
    private currentEl!: HTMLElement;
    private durationEl!: HTMLElement;
    private announcer!: HTMLElement;
    private track: Track | null = null;
    private scrubbing = false;

    connectedCallback() {
      // transition:persist moves this element into every new page, which
      // fires connectedCallback again. Wire everything up exactly once, and
      // only for the first (persisted) instance.
      if (livePlayer) return;
      livePlayer = this;

      this.audio = this.querySelector('audio')!;
      this.panel = this.querySelector('.player')!;
      this.toggleButton = this.querySelector('[data-action="toggle"]')!;
      this.scrubber = this.querySelector('[data-scrubber]')!;
      this.titleEl = this.querySelector('[data-title]')!;
      this.currentEl = this.querySelector('[data-current]')!;
      this.durationEl = this.querySelector('[data-duration]')!;
      this.announcer = this.querySelector('[data-announce]')!;

      // One delegated listener covers every play button on every page.
      document.addEventListener('click', (event) => {
        const button = (event.target as Element).closest<HTMLElement>('[data-play-track]');
        if (button) this.handlePlayButton(button);
      });

      this.toggleButton.addEventListener('click', () => this.toggle());
      this.querySelector('[data-action="close"]')!.addEventListener('click', () => this.close());

      // While dragging, only the readout moves; the seek happens on release,
      // so the audio does not stutter through every intermediate position.
      this.scrubber.addEventListener('input', () => {
        this.scrubbing = true;
        this.renderTime(Number(this.scrubber.value));
      });
      this.scrubber.addEventListener('change', () => {
        this.audio.currentTime = Number(this.scrubber.value);
        this.scrubbing = false;
      });

      // K, J and L (the common media convention) work while focus is
      // anywhere inside the player. Scoped, so they never hijack typing or
      // screen-reader keys elsewhere on the page.
      this.addEventListener('keydown', (event) => {
        if (event.metaKey || event.ctrlKey || event.altKey) return;
        const key = event.key.toLowerCase();
        if (key === 'k') this.toggle();
        else if (key === 'j') this.skip(-SKIP_SECONDS);
        else if (key === 'l') this.skip(SKIP_SECONDS);
        else return;
        event.preventDefault();
      });

      this.audio.addEventListener('play', () => this.renderState());
      this.audio.addEventListener('pause', () => this.renderState());
      this.audio.addEventListener('loadedmetadata', () => this.renderTime());
      this.audio.addEventListener('timeupdate', () => {
        if (!this.scrubbing) this.renderTime();
        this.updatePositionState();
      });
      this.audio.addEventListener('ended', () => {
        this.audio.currentTime = 0;
        this.renderState();
      });
      this.audio.addEventListener('error', () => {
        if (this.track) this.announce(`${this.track.title} could not be loaded.`);
      });

      // Only one source of sound at a time: the A/B player announces when it
      // starts, and this player pauses.
      window.addEventListener('tesh:audio-start', (event) => {
        if ((event as CustomEvent).detail !== 'player') this.audio.pause();
      });

      // ClientRouter replaces <html> attributes and inline styles on every
      // navigation, so the page offset must be re-applied after each swap.
      document.addEventListener('astro:after-swap', () => this.applyOffset());
      document.addEventListener('astro:page-load', () => this.syncButtons());

      this.setUpMediaSession();
    }

    private handlePlayButton(button: HTMLElement) {
      const id = button.dataset.playTrack!;
      if (this.track?.id === id) {
        this.toggle();
        return;
      }
      this.load({
        id,
        title: button.dataset.title ?? '',
        src: button.dataset.src!,
        artwork: button.dataset.artwork,
        duration: Number(button.dataset.duration) || 0,
      });
      this.play();
    }

    private load(track: Track) {
      this.track = track;
      this.audio.src = track.src;
      this.titleEl.textContent = track.title;
      this.scrubber.max = String(track.duration);
      this.scrubber.value = '0';
      this.renderTime(0);
      this.open();
      this.announce(`Now playing: ${track.title}`);

      if ('mediaSession' in navigator) {
        const artwork = track.artwork || this.dataset.fallbackArtwork;
        navigator.mediaSession.metadata = new MediaMetadata({
          title: track.title,
          artist: this.dataset.artist,
          artwork: artwork ? [{ src: new URL(artwork, location.href).href, sizes: '512x512', type: 'image/png' }] : [],
        });
      }
    }

    private play() {
      window.dispatchEvent(new CustomEvent('tesh:audio-start', { detail: 'player' }));
      this.audio.play().catch(() => {
        // Autoplay policies can reject play() if it was not tied to a tap;
        // the button state stays "paused", which is accurate.
      });
    }

    private toggle() {
      if (!this.track) return;
      if (this.audio.paused) this.play();
      else this.audio.pause();
    }

    private skip(seconds: number) {
      if (!this.track) return;
      const duration = this.duration();
      this.audio.currentTime = Math.min(Math.max(0, this.audio.currentTime + seconds), duration || 0);
    }

    private duration() {
      // The real duration once metadata loads; the stored one before that.
      return Number.isFinite(this.audio.duration) && this.audio.duration > 0
        ? this.audio.duration
        : (this.track?.duration ?? 0);
    }

    private open() {
      this.panel.hidden = false;
      this.applyOffset();
    }

    private close() {
      this.audio.pause();
      this.audio.removeAttribute('src');
      this.audio.load();
      this.track = null;
      this.panel.hidden = true;
      this.applyOffset();
      this.syncButtons();
      if ('mediaSession' in navigator) navigator.mediaSession.metadata = null;
      // The close button has just disappeared; move focus somewhere sensible
      // instead of letting it fall back to the top of the document.
      document.getElementById('main')?.focus({ preventScroll: true });
    }

    /** Space for the player at the end of the page, so it never covers the footer. */
    private applyOffset() {
      const height = this.panel.hidden ? 0 : this.panel.offsetHeight;
      document.documentElement.style.setProperty('--player-offset', `${height}px`);
    }

    private renderState() {
      const playing = !this.audio.paused;
      this.toggleButton.setAttribute('aria-label', playing ? 'Pause' : 'Play');
      this.panel.dataset.playing = String(playing);
      if ('mediaSession' in navigator) {
        navigator.mediaSession.playbackState = playing ? 'playing' : 'paused';
      }
      this.syncButtons();
    }

    private renderTime(position = this.audio.currentTime) {
      const duration = this.duration();
      this.scrubber.max = String(duration);
      if (!this.scrubbing) this.scrubber.value = String(position);
      // Drives the filled part of the track in CSS.
      this.scrubber.style.setProperty('--progress', duration ? `${(position / duration) * 100}%` : '0%');
      this.currentEl.textContent = formatDuration(position);
      this.durationEl.textContent = formatDuration(duration, { total: true });
      this.scrubber.setAttribute(
        'aria-valuetext',
        `${spokenDuration(position)} of ${spokenDuration(duration)}`,
      );
    }

    /** Keeps every play button on the current page in step with the player. */
    private syncButtons() {
      const playing = !this.audio.paused;
      document.querySelectorAll<HTMLElement>('[data-play-track]').forEach((button) => {
        const isCurrent = button.dataset.playTrack === this.track?.id;
        const pressed = isCurrent && playing;
        button.setAttribute('aria-pressed', String(pressed));
        button.setAttribute('aria-label', `${pressed ? 'Pause' : 'Play'} ${button.dataset.title}`);
        const row = button.closest<HTMLElement>('[data-track-row]');
        if (row) {
          if (isCurrent) row.dataset.current = playing ? 'playing' : 'paused';
          else delete row.dataset.current;
        }
      });
    }

    private announce(message: string) {
      this.announcer.textContent = message;
    }

    /** Lock-screen and headset controls on phones and desktops. */
    private setUpMediaSession() {
      if (!('mediaSession' in navigator)) return;
      const session = navigator.mediaSession;
      const handlers: [MediaSessionAction, MediaSessionActionHandler][] = [
        ['play', () => this.play()],
        ['pause', () => this.audio.pause()],
        ['seekbackward', (d) => this.skip(-(d.seekOffset ?? SKIP_SECONDS))],
        ['seekforward', (d) => this.skip(d.seekOffset ?? SKIP_SECONDS)],
        ['seekto', (d) => {
          if (d.seekTime != null) this.audio.currentTime = d.seekTime;
        }],
      ];
      for (const [action, handler] of handlers) {
        try {
          session.setActionHandler(action, handler);
        } catch {
          // Older browsers throw for actions they do not support.
        }
      }
    }

    private updatePositionState() {
      const duration = this.duration();
      if (!('mediaSession' in navigator) || !duration) return;
      try {
        navigator.mediaSession.setPositionState({
          duration,
          playbackRate: this.audio.playbackRate,
          position: Math.min(this.audio.currentTime, duration),
        });
      } catch {
        // setPositionState throws if position briefly exceeds duration.
      }
    }
  }

  customElements.define('tesh-player', TeshPlayer);
</script>

<style>
  .player {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    /* iPhone home indicator: keep controls clear of it. */
    padding: var(--space-3) var(--space-3) calc(var(--space-3) + env(safe-area-inset-bottom));
    pointer-events: none;
    background-color: transparent;
  }

  .player[hidden] {
    display: none;
  }

  .player__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    max-width: 44rem;
    margin-inline: auto;
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: color-mix(in oklab, var(--color-surface-raised) 92%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: var(--shadow-3);
    pointer-events: auto;
  }

  .player__toggle {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
    color: var(--color-accent-contrast);
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .player__toggle:active {
    transform: scale(0.95);
  }

  .icon-pause,
  [data-playing='true'] .icon-play {
    display: none;
  }

  [data-playing='true'] .icon-pause {
    display: block;
  }

  .player__body {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .player__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .player__title {
    overflow: hidden;
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .player__time {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .player__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .player__close:hover {
    color: var(--color-text);
    background-color: color-mix(in oklab, var(--color-text) 8%, transparent);
  }
</style>
