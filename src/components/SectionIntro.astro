---
/**
 * SectionIntro
 *
 * Eyebrow, heading and optional lead at the top of a Home section, with an
 * optional "see all" link aligned to the right on wide screens. One
 * component so every section opens with the same rhythm.
 */
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  index?: string;
  title: string;
  id: string;
  lead?: string;
  link?: { label: string; href: string };
}

const { eyebrow, index, title, id, lead, link } = Astro.props;
---

<div class="intro">
  <div class="intro__text glow">
    <Eyebrow index={index}>{eyebrow}</Eyebrow>
    <h2 id={id} class="intro__title">{title}</h2>
    {lead && <p class="intro__lead">{lead}</p>}
  </div>
  {
    link && (
      <a class="intro__link" href={link.href}>
        {link.label}
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
          <path d="M3 7h8M7.5 3.5L11 7l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    )
  }
</div>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: clamp(var(--space-10), 5vw, var(--space-16));
  }

  .intro__text {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
  }

  .intro__title {
    font-size: var(--step-4);
  }

  .intro__lead {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .intro__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .intro__link svg {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .intro__link:hover svg {
    transform: translateX(3px);
  }
</style>
