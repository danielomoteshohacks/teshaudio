---
/**
 * ProjectPanel: a project as one large panel, with its artwork above the
 * status, title and one line, and optionally one of Tesh's beliefs quoted
 * beneath the summary.
 *
 * The panel is still one big tap target and one focus stop for the project:
 * the title is the link, stretched over the whole panel with a pseudo-element.
 * It is built this way (not as one wrapping <a>) because the belief line is
 * a second link, to its row on About, and a link cannot contain a link. The
 * belief link sits above the stretched one (z-index) so it takes its own
 * clicks.
 *
 * An essay about the project, when there is one, gets its own "Read the
 * story" link beside "View project", built the same way as the belief line.
 *
 * Hover lifts the panel slightly (2px and one tonal step) with a soft
 * highlight on its border, and slides in the underline on "View project".
 * On touch screens, where hover never fires, the same happens while the
 * panel is pressed, and a press gives slightly (scale 0.99). No shadow.
 */
import type { CollectionEntry } from 'astro:content';
import ProjectArt from './art/ProjectArt.astro';
import Status from './Status.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
  /** A belief quoted under the summary, with the link to its row on About. */
  belief?: { text: string; href: string };
  /** The essay written about the project, linked beside "View project". */
  story?: { href: string; title: string };
}

const { project, headingLevel: Heading = 'h3', belief, story } = Astro.props;
const { title, tagline, summary, status } = project.data;
---

<article class="panel">
  <div class="panel__art">
    <ProjectArt id={project.id} />
  </div>
  <div class="panel__body">
    <Status status={status} />
    <Heading class="panel__title">
      <a class="panel__link" href={`/projects/${project.id}/`}>{title}</a>
    </Heading>
    <p class="panel__line">{tagline ?? summary}</p>
    {
      belief && (
        <p class="panel__belief voice">
          <a href={belief.href}>{belief.text}</a>
        </p>
      )
    }
    <div class="panel__links">
      <span class="panel__more" aria-hidden="true"><span class="slide-link">View project</span> &rarr;</span>
      {
        story && (
          <a class="panel__story" href={story.href} aria-label={`Read the story: ${story.title}`}>
            <span class="slide-link">Read the story</span> <span aria-hidden="true">&rarr;</span>
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .panel {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    background-color: var(--color-bg-2);
    color: var(--color-text);
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) {
    .panel:hover {
      border-color: var(--color-line-strong);
      background-color: var(--color-bg-3);
      transform: translateY(-2px);
    }

    .panel:hover .panel__more .slide-link {
      background-size: 100% 1px;
    }
  }

  .panel:active {
    border-color: var(--color-line-strong);
    background-color: var(--color-bg-3);
    transform: scale(0.99);
  }

  /* The title link covers the whole panel. */
  .panel__link {
    color: inherit;
    text-decoration: none;
  }

  .panel__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* The focus ring goes round the whole panel, which is what the link covers,
     not just the title text. */
  .panel__link:focus-visible {
    outline: none;
  }

  .panel:has(.panel__link:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
  }

  .panel__art {
    aspect-ratio: 8 / 5;
    padding: clamp(var(--space-4), 3vw, var(--space-8));
    border-bottom: 1px solid var(--color-line);
  }

  .panel__body {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: clamp(var(--space-6), 3vw, var(--space-10));
  }

  .panel__title {
    margin-top: var(--space-2);
    font-size: var(--step-3);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-display);
  }

  .panel__line {
    max-width: 30rem;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-text-2);
  }

  /* A small serif line in the muted colour, under the summary. Its link sits
     above the stretched title link. The faint underline says "link" without
     colour; it firms up on hover. */
  .panel__belief {
    max-width: 30rem;
    font-size: var(--step-0);
    line-height: var(--leading-snug);
    color: var(--color-text-3);
  }

  .panel__belief a {
    position: relative;
    z-index: 1;
    /* A comfortable tap target without changing how the line sits. */
    display: inline-block;
    padding-block: 0.6rem;
    margin-block: -0.6rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    text-decoration-color: var(--color-line-strong);
  }

  .panel__belief a:hover,
  .panel__belief a:focus-visible {
    color: var(--color-text);
    text-decoration-color: currentColor;
  }

  .panel__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-6);
    margin-top: var(--space-4);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
  }

  /* The story link sits above the stretched title link, like the belief
     line, so it takes its own clicks; padded to a 44px tap target. */
  .panel__story {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: none;
  }

  .panel__story:is(:hover, :focus-visible, :active) .slide-link {
    background-size: 100% 1px;
  }

  .panel:active .panel__more .slide-link {
    background-size: 100% 1px;
  }
</style>
