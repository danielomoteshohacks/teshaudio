---
/**
 * Badge
 *
 * Small mono pill for status and metadata ("Active", "Coming soon", "Test
 * audio"). Tones carry meaning without relying on colour alone: the text
 * always states the status, and the dot is decorative.
 */
interface Props {
  tone?: 'accent' | 'neutral';
  dot?: boolean;
}

const { tone = 'neutral', dot = false } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`]}>
  {dot && <span class="badge__dot" aria-hidden="true" />}
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 24px;
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text-muted);
  }

  .badge--accent {
    border-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
    background-color: color-mix(in oklab, var(--color-accent) 8%, transparent);
    color: var(--color-accent);
  }

  /* Status dots use the warm accent: a small amber "lamp" on every badge. */
  .badge__dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background-color: var(--color-warm);
  }
</style>
