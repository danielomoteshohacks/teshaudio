---
/**
 * Eyebrow
 *
 * Small monospace uppercase label above a heading, borrowed from technical
 * drawings and spec sheets (the engineering layer). It gives context ("Project",
 * "Research note") without competing with the headline.
 *
 * index: optional section number such as "01", shown in the accent colour.
 * The slash separator is decorative, so screen readers skip it.
 */
interface Props {
  as?: 'p' | 'span' | 'div';
  index?: string;
}

const { as: Tag = 'p', index } = Astro.props;
---

<Tag class="eyebrow">
  {
    index && (
      <span class="eyebrow__index">
        {index}
        <span aria-hidden="true"> /</span>
      </span>
    )
  }
  <slot />
</Tag>

<style>
  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .eyebrow__index {
    color: var(--color-accent);
    /* Equal-width digits so "01" and "10" align when stacked. */
    font-variant-numeric: tabular-nums;
  }
</style>
