---
/**
 * WritingView
 *
 * The writing index, shared by /writing/ (all kinds) and
 * /writing/kind/[kind]/ (filtered). Same reasoning as ProjectsView: filters
 * are static pages, so they need no JavaScript and can be linked directly.
 */
import type { CollectionEntry } from 'astro:content';
import PageHeader from './PageHeader.astro';
import Section from './Section.astro';
import Container from './Container.astro';
import FilterNav from './FilterNav.astro';
import WritingRow from './WritingRow.astro';
import EmptyState from './EmptyState.astro';
import Button from './Button.astro';
import { kindLabel } from '../lib/format';
import { copy } from '../lib/site';

type Kind = CollectionEntry<'writing'>['data']['kind'];

interface Props {
  all: CollectionEntry<'writing'>[];
  kind?: Kind;
}

const { all, kind } = Astro.props;
const kinds: Kind[] = ['essay', 'research', 'note', 'finding'];
const plural = { essay: 'Essays', research: 'Research', note: 'Notes', finding: 'Findings' } as const;
const shown = kind ? all.filter((e) => e.data.kind === kind) : all;

const filters = [
  { label: 'All', href: '/writing/', count: all.length },
  ...kinds.map((k) => ({
    label: plural[k],
    href: `/writing/kind/${k}/`,
    count: all.filter((e) => e.data.kind === k).length,
  })),
];
---

<PageHeader eyebrow="Writing" title={copy.writing.title} lead={copy.writing.lead}>
  <div class="filters">
    <FilterNav label="Filter writing by kind" items={filters} />
  </div>
</PageHeader>

<Section spacing="flush-top" aria-label={kind ? plural[kind] : 'All writing'}>
  <Container>
    {
      shown.length > 0 ? (
        <div class="list">
          {shown.map((entry) => (
            <WritingRow entry={entry} headingLevel="h2" />
          ))}
        </div>
      ) : (
        <EmptyState
          title={kind ? `${plural[kind]} coming soon` : 'Writing is on the way'}
          body={
            kind
              ? `${kindLabel[kind]} entries will appear here.`
              : 'Essays, research notes and findings will appear here.'
          }
        >
          <Button variant="secondary" href="/rss.xml">
            Follow via RSS
          </Button>
        </EmptyState>
      )
    }
  </Container>
</Section>

<style>
  .filters {
    margin-top: var(--space-4);
  }

  .list {
    max-width: 52rem;
    border-top: 1px solid var(--color-border);
  }
</style>
