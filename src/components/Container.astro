---
/**
 * Container
 *
 * Centres content, caps its width and applies the fluid side gutter. Every
 * page section puts its content in one, so left edges line up down the page.
 *
 * width: "default" for layouts and grids, "narrow" for long-form reading,
 * where a capped line length is easier on the eye.
 */
interface Props {
  as?: 'div' | 'header' | 'footer' | 'main' | 'article' | 'nav';
  width?: 'default' | 'narrow';
  class?: string;
}

const { as: Tag = 'div', width = 'default', class: className } = Astro.props;
---

<Tag class:list={['container', `container--${width}`, className]}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-gutter);
  }

  .container--narrow {
    max-width: var(--container-narrow);
  }
</style>
