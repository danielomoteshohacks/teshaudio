---
/**
 * PlayButton
 *
 * Hands a track to the persistent player. It carries everything the player
 * needs in data attributes, so the player never has to fetch track data and
 * this button works on any page, including inside MDX articles.
 * AudioPlayer.astro keeps aria-pressed and the label in sync.
 */
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';

interface Props {
  track: CollectionEntry<'tracks'>;
  size?: 'md' | 'lg';
}

const { track, size = 'md' } = Astro.props;

// Square PNG for lock-screen artwork (see AudioPlayer.astro).
const artwork = track.data.artwork
  ? (await getImage({ src: track.data.artwork, width: 512, height: 512, fit: 'cover', format: 'png' })).src
  : undefined;
---

<button
  class:list={['play', `play--${size}`]}
  type="button"
  aria-pressed="false"
  aria-label={`Play ${track.data.title}`}
  data-play-track={track.id}
  data-title={track.data.title}
  data-src={track.data.audioUrl}
  data-artwork={artwork}
  data-duration={track.data.durationSeconds}
>
  <svg class="play__icon play__icon--play" viewBox="0 0 18 18" aria-hidden="true">
    <path d="M5 3.5v11l9-5.5z" fill="currentColor"></path>
  </svg>
  <svg class="play__icon play__icon--pause" viewBox="0 0 18 18" aria-hidden="true">
    <path d="M5 3.5h2.75v11H5zM10.25 3.5H13v11h-2.75z" fill="currentColor"></path>
  </svg>
</button>

<style>
  .play {
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    border: 0;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
    color: var(--color-accent-contrast);
    cursor: pointer;
    transition:
      transform var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .play:hover {
    background-color: color-mix(in oklab, var(--color-accent) 85%, var(--color-text));
  }

  .play:active {
    transform: scale(0.95);
  }

  .play--md {
    width: 44px;
    height: 44px;
  }

  .play--lg {
    width: 56px;
    height: 56px;
  }

  .play__icon {
    width: 18px;
    height: 18px;
  }

  .play--lg .play__icon {
    width: 22px;
    height: 22px;
  }

  .play__icon--pause,
  .play[aria-pressed='true'] .play__icon--play {
    display: none;
  }

  .play[aria-pressed='true'] .play__icon--pause {
    display: block;
  }
</style>
