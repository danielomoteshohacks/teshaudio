---
/**
 * Stat
 *
 * Big number with a small mono label underneath (the engineering layer's
 * bold stat counters).
 *
 * Must be placed inside a <dl>. It renders a <dt> (label) and <dd> (value),
 * so screen readers announce "label, value" as a pair. CSS shows the value
 * first visually, without changing that reading order.
 *
 * Static on purpose: a count-up animation needs JavaScript and can come later
 * with a reduced-motion fallback.
 */
interface Props {
  value: string | number;
  label: string;
  prefix?: string;
  suffix?: string;
}

const { value, label, prefix, suffix } = Astro.props;
---

<div class="stat">
  <dt class="stat__label">{label}</dt>
  <dd class="stat__value">
    {prefix && <span class="stat__affix">{prefix}</span>}
    {value}
    {suffix && <span class="stat__affix">{suffix}</span>}
  </dd>
</div>

<style>
  .stat {
    display: flex;
    /* Value above label visually, label first in the source for screen readers. */
    flex-direction: column-reverse;
    gap: var(--space-2);
  }

  .stat__value {
    margin: 0;
    font-size: var(--step-5);
    font-weight: var(--weight-bold);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    /* Equal-width digits keep a row of stats visually aligned. */
    font-variant-numeric: tabular-nums;
  }

  .stat__affix {
    margin-inline: 0.05em;
    font-size: 0.5em;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-accent);
  }

  .stat__label {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
</style>
