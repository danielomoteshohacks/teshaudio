---
/**
 * CoverArt
 *
 * The site's own cover illustration for writing about spatial audio: a
 * listener seen from above, sound sources glowing around them on a dark
 * stage, the distance rings of a room. Drawn here as SVG, so it is original,
 * sharp at any size, and a few hundred bytes.
 *
 * Used when an article's cover photo has not been added yet, so the lead
 * story never shows a stand-in stock image. Always dark, like a stage, in
 * both site modes. The art fills its container (cropped, never squashed), so
 * the parent decides the shape.
 */
interface Props {
  /** Unique per page, because SVG gradient ids are global to the document. */
  id: string;
  /** Decorative by default; pass a label when the art stands in for a photo. */
  label?: string;
}

const { id, label } = Astro.props;

// Sound sources around the listener: [angle in degrees (0 = in front), ring
// radius, size, colour]. Placed by the same rules the essay describes: the
// voice in front, the bass at the centre, the rest opening up around.
const sources: [number, number, number, 'cobalt' | 'amber' | 'white'][] = [
  [0, 150, 15, 'amber'],
  [-32, 250, 10, 'cobalt'],
  [34, 250, 10, 'cobalt'],
  [-78, 205, 8, 'white'],
  [82, 215, 8, 'white'],
  [-128, 300, 7, 'cobalt'],
  [136, 290, 7, 'cobalt'],
  [180, 330, 6, 'white'],
  [-12, 360, 6, 'white'],
  [18, 395, 5, 'amber'],
];
const cx = 600;
const cy = 420;
const point = (deg: number, r: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
};
const fill = { cobalt: '#7f97ff', amber: '#ffb070', white: '#f3ece2' };
---

<svg
  class="cover-art"
  viewBox="0 0 1200 800"
  preserveAspectRatio="xMidYMid slice"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <defs>
    <radialGradient id={`${id}-cobalt`} cx="0.62" cy="0.78" r="0.7">
      <stop offset="0" stop-color="#2b4dff" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#2b4dff" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id={`${id}-amber`} cx="0.12" cy="0.05" r="0.6">
      <stop offset="0" stop-color="#ff9a3d" stop-opacity="0.34"></stop>
      <stop offset="1" stop-color="#ff9a3d" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id={`${id}-dot`}>
      <stop offset="0" stop-color="#fff" stop-opacity="0.5"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <rect width="1200" height="800" fill="#0b0a10"></rect>
  <rect width="1200" height="800" fill={`url(#${id}-cobalt)`}></rect>
  <rect width="1200" height="800" fill={`url(#${id}-amber)`}></rect>

  {/* Distance rings: close, the room, far away. */}
  <g fill="none" stroke="#f3ece2">
    <circle cx={cx} cy={cy} r="150" stroke-opacity="0.16"></circle>
    <circle cx={cx} cy={cy} r="250" stroke-opacity="0.11" stroke-dasharray="2 8"></circle>
    <circle cx={cx} cy={cy} r="360" stroke-opacity="0.08"></circle>
    <circle cx={cx} cy={cy} r="500" stroke-opacity="0.05" stroke-dasharray="2 10"></circle>
  </g>

  {/* Sources, each with a soft halo. */}
  {
    sources.map(([deg, r, size, tone]) => {
      const [x, y] = point(deg, r);
      return (
        <g>
          <circle cx={x} cy={y} r={size * 4.5} fill={`url(#${id}-dot)`} opacity="0.5" />
          <circle cx={x} cy={y} r={size} fill={fill[tone]} />
        </g>
      );
    })
  }

  {/* The listener from above: head, nose pointing forward, ears. */}
  <g>
    <circle cx={cx} cy={cy} r="64" fill={`url(#${id}-dot)`} opacity="0.35"></circle>
    <ellipse cx={cx - 40} cy={cy} rx="8" ry="15" fill="#f3ece2" fill-opacity="0.9"></ellipse>
    <ellipse cx={cx + 40} cy={cy} rx="8" ry="15" fill="#f3ece2" fill-opacity="0.9"></ellipse>
    <path d={`M${cx - 9} ${cy - 37} L${cx} ${cy - 52} L${cx + 9} ${cy - 37} Z`} fill="#f3ece2"></path>
    <circle cx={cx} cy={cy} r="38" fill="#f3ece2"></circle>
  </g>
</svg>

<style>
  .cover-art {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
