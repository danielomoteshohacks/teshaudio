---
/**
 * The top-down stage used by IntelligentMixer.astro, generated from one
 * list of placements at a given centre and scale, so the wide and narrow
 * drawings agree exactly. Direction is the angle around the head (front is
 * up), distance is the ring, and a ring around a dot means "above you".
 * Positions are illustrative, not one song's real profile.
 */
import ListenerHead from './ListenerHead.astro';

interface Props {
  cx: number;
  cy: number;
  /** Ring radii: close, room, far. */
  rings: [number, number, number];
  /** Narrow drawings: labels rearranged to stay clear of each other, and
   *  the bass label left to the key below the drawing. */
  compact?: boolean;
}

const { cx, cy, rings, compact = false } = Astro.props;
const [close, room, far] = rings;

const at = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return { x: cx + r * Math.sin(a), y: cy - r * Math.cos(a) };
};

type Place = { label: string; deg: number; r: number; above?: boolean; tone: 'accent' | 'warm' | 'ink'; dx?: number; dy: number; anchor?: string };
const places: Place[] = [
  { label: 'Lead vocal', deg: 0, r: close, tone: 'accent', dy: -14 },
  { label: 'Drums', deg: 0, r: room, tone: 'warm', dy: -14 },
  { label: 'Percussion', deg: -50, r: room, tone: 'warm', dy: compact ? 24 : -14 },
  { label: 'Percussion', deg: 50, r: room, tone: 'warm', dy: compact ? 24 : -14 },
  { label: 'Pads', deg: -95, r: (room + far) / 2 + 10, above: true, tone: 'ink', dy: 30 },
  { label: 'Pads', deg: 95, r: (room + far) / 2 + 10, above: true, tone: 'ink', dy: 30 },
  { label: 'Backing', deg: -140, r: (close + room) / 2 + 8, above: true, tone: 'accent', dy: 30 },
  { label: 'Backing', deg: 140, r: (close + room) / 2 + 8, above: true, tone: 'accent', dy: 30 },
  { label: 'Reverb', deg: 180, r: far, above: true, tone: 'ink', dy: 30 },
];
const dots = places.map((p) => ({ ...p, ...at(p.deg, p.r) }));
const fill = { accent: 'f-accent', warm: 'f-warm', ink: 'f-ink' };
const stroke = { accent: 's-accent', warm: 's-warm', ink: 's-ink' };
const bass = close * 0.62;
---

<g>
  <path class="s-line" d={`M${cx - 5} ${cy - far - 8} L${cx} ${cy - far - 15} L${cx + 5} ${cy - far - 8}`} stroke-width="1.25" stroke-linejoin="round"></path>
  <text class="t t-small" x={cx} y={cy - far - 22} text-anchor="middle">Front</text>

  <circle class="s-line" cx={cx} cy={cy} r={close} stroke-width="1"></circle>
  <circle class="s-line" cx={cx} cy={cy} r={room} stroke-width="1" stroke-dasharray="3 5"></circle>
  <circle class="s-line" cx={cx} cy={cy} r={far} stroke-width="1" stroke-dasharray="1 5"></circle>

  {/* The bass: a field around the listener, not a point. */}
  <circle class="s-warm" cx={cx} cy={cy} r={bass} stroke-width="1.25" stroke-dasharray="2 3"></circle>
  <ListenerHead x={cx} y={cy} r={close * 0.27} />
  {!compact && <text class="t t-warm" x={cx} y={cy + bass + 18} text-anchor="middle">Bass, centred</text>}

  {
    dots.map((d) => (
      <g>
        {d.above && <circle class={stroke[d.tone]} cx={d.x} cy={d.y} r="11" stroke-width="1.25" />}
        <circle class={fill[d.tone]} cx={d.x} cy={d.y} r="5" />
        <text class="t" x={d.x + (d.dx ?? 0)} y={d.y + d.dy} text-anchor={d.anchor ?? 'middle'}>
          {d.label}
        </text>
      </g>
    ))
  }
</g>
