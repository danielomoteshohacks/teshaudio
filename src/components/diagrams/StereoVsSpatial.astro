---
/**
 * Diagram: stereo vs spatial, seen from above.
 *
 * Two panels side by side (stacked on phones): in stereo every sound sits on
 * the line between the ears; in spatial audio sounds are placed around the
 * listener in a room, with reflections coming back off the walls.
 * Two SVGs rather than one wide one, so each panel stays readable on a phone.
 */
import Diagram from './Diagram.astro';
import ListenerHead from './ListenerHead.astro';
---

<Diagram caption="Seen from above. Stereo places every sound on one line between your ears. Spatial audio opens that line into a room around you.">
  <div class="panels">
    <svg viewBox="0 0 320 300" role="img" aria-labelledby="svs-a-title svs-a-desc">
      <title id="svs-a-title">Stereo</title>
      <desc id="svs-a-desc">A listener's head seen from above. A single straight line runs from the left ear to the right ear, and the drums, vocal and keys all sit somewhere on that line.</desc>
      <text class="d-mono d-muted" x="160" y="24" text-anchor="middle">Stereo</text>
      <ListenerHead x={160} y={175} />
      {/* The stereo line: drawn over the head, because that is where stereo
          puts the music, inside it. */}
      <g class="d-accent">
        <line x1="62" y1="175" x2="258" y2="175" stroke="currentColor" stroke-width="3" stroke-linecap="round"></line>
        <circle cx="62" cy="175" r="7" fill="currentColor"></circle>
        <circle cx="160" cy="175" r="7" fill="currentColor"></circle>
        <circle cx="258" cy="175" r="7" fill="currentColor"></circle>
      </g>
      <g class="d-ink" text-anchor="middle">
        <text class="d-small" x="62" y="205">Keys</text>
        <text class="d-small" x="160" y="230">Vocal</text>
        <text class="d-small" x="258" y="205">Drums</text>
      </g>
      <text class="d-small d-muted" x="160" y="270" text-anchor="middle">Everything on one line</text>
    </svg>

    <svg viewBox="0 0 320 300" role="img" aria-labelledby="svs-b-title svs-b-desc">
      <title id="svs-b-title">Spatial</title>
      <desc id="svs-b-desc">The same head seen from above, inside a room. The drums sit in front, the vocal just ahead of the listener, background vocals float to either side and the keys sit behind, while reverb comes back off the walls.</desc>
      <text class="d-mono d-muted" x="160" y="24" text-anchor="middle">Spatial</text>
      {/* The room, and reflections returning off its walls. */}
      <rect class="d-line" x="22" y="42" width="276" height="244" rx="22" fill="none" stroke="currentColor" stroke-dasharray="3 6"></rect>
      <g class="d-warm" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.8">
        <path d="M40 70 q14 -10 28 -16"></path>
        <path d="M40 84 q20 -16 40 -24"></path>
        <path d="M280 70 q-14 -10 -28 -16"></path>
        <path d="M280 84 q-20 -16 -40 -24"></path>
        <path d="M40 268 q14 8 28 12"></path>
        <path d="M280 268 q-14 8 -28 12"></path>
      </g>
      <ListenerHead x={160} y={185} />
      <g class="d-accent" fill="currentColor">
        <circle cx="160" cy="74" r="7"></circle>
        <circle cx="160" cy="128" r="7"></circle>
        <circle cx="62" cy="172" r="6"></circle>
        <circle cx="258" cy="172" r="6"></circle>
        <circle cx="110" cy="256" r="6"></circle>
      </g>
      <g class="d-ink" text-anchor="middle">
        <text class="d-small" x="160" y="98">Drums</text>
        <text class="d-small" x="200" y="132">Vocal</text>
        <text class="d-small" x="62" y="198">Backing</text>
        <text class="d-small" x="258" y="198">Backing</text>
        <text class="d-small" x="152" y="260" text-anchor="start">Keys</text>
      </g>
      <text class="d-small d-warm" x="252" y="112" text-anchor="middle">Reverb</text>
    </svg>
  </div>
</Diagram>

<style>
  .panels {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 36rem) {
    .panels {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
