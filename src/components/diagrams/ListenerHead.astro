---
/**
 * A listener's head seen from above, nose pointing up (forward), shared by
 * the diagrams so the listener looks the same in every figure. Must be used
 * inside an <svg>. `r` scales the whole head.
 */
interface Props {
  x: number;
  y: number;
  r?: number;
}

const { x, y, r = 30 } = Astro.props;
const ear = { rx: r * 0.2, ry: r * 0.38 };
---

<g class="d-ink">
  <ellipse cx={x - r} cy={y} rx={ear.rx} ry={ear.ry} class="d-paper" fill="currentColor"></ellipse>
  <ellipse cx={x - r} cy={y} rx={ear.rx} ry={ear.ry} fill="none" stroke="currentColor" stroke-width="1.5"></ellipse>
  <ellipse cx={x + r} cy={y} rx={ear.rx} ry={ear.ry} class="d-paper" fill="currentColor"></ellipse>
  <ellipse cx={x + r} cy={y} rx={ear.rx} ry={ear.ry} fill="none" stroke="currentColor" stroke-width="1.5"></ellipse>
  <path
    d={`M${x - r * 0.28} ${y - r * 0.92} L${x} ${y - r * 1.3} L${x + r * 0.28} ${y - r * 0.92}`}
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linejoin="round"
  ></path>
  <circle cx={x} cy={y} r={r} class="d-paper" fill="currentColor"></circle>
  <circle cx={x} cy={y} r={r} fill="none" stroke="currentColor" stroke-width="1.5"></circle>
</g>
