---
/**
 * Diagram: the figure frame shared by the article diagrams.
 *
 * A quiet panel (one tonal step above the page, hairline border) with a
 * numbered caption in small grey text. In articles it breaks slightly out of
 * the text column on wide screens (see the article page).
 *
 * Responsive diagrams: a diagram can pass two drawings, `wide` and `narrow`
 * slots. The figure is a size container, and only the drawing that suits
 * its width is displayed, so labels stay at a legible size on a 360px phone
 * instead of shrinking with a wide drawing. display: none also removes the
 * hidden drawing from the accessibility tree, so it is never read twice.
 */
interface Props {
  caption?: string;
  /** Number the caption ("Figure 1."). Off for artwork reuse. */
  numbered?: boolean;
  class?: string;
}

const { caption, numbered = true, class: className } = Astro.props;
const hasNarrow = Astro.slots.has('narrow');
---

<figure class:list={['diagram', className]}>
  <div class="diagram__media">
    {
      hasNarrow ? (
        <>
          <div class="diagram__wide">
            <slot />
          </div>
          <div class="diagram__narrow">
            <slot name="narrow" />
          </div>
        </>
      ) : (
        <slot />
      )
    }
  </div>
  {
    caption && (
      <figcaption class="diagram__caption">
        {numbered && <span class="diagram__label">Figure</span>} {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .diagram {
    counter-increment: figure;
    container-type: inline-size;
  }

  .diagram__media {
    padding: clamp(var(--space-4), 3.5cqi, var(--space-8));
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-2);
  }

  /* Every drawing carries width and height attributes (so Safari can size
     it from its aspect ratio) and is scaled to the column here. */
  .diagram__media :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .diagram__narrow {
    display: none;
  }

  @container (max-width: 34rem) {
    .diagram__wide {
      display: none;
    }

    .diagram__narrow {
      display: block;
    }
  }

  .diagram__caption {
    margin-top: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--color-text-3);
  }

  .diagram__label {
    font-weight: var(--weight-semibold);
    color: var(--color-text-2);
  }

  .diagram__label::after {
    content: ' ' counter(figure) '.';
  }
</style>
