---
/**
 * Diagram: your daily sound bundle. The NIOSH recommended exposure limit as
 * a bar chart: 85 dBA for 8 hours, and every 3 dB louder halves the safe
 * time (a 3 dB exchange rate). Bars are drawn to true scale in time, so the
 * loudest levels are honest slivers, and they shift from cobalt to amber as
 * the level rises.
 */
import Diagram from './Diagram.astro';

const rows = [
  { db: 85, minutes: 480, label: '8 h' },
  { db: 88, minutes: 240, label: '4 h' },
  { db: 91, minutes: 120, label: '2 h' },
  { db: 94, minutes: 60, label: '1 h' },
  { db: 97, minutes: 30, label: '30 min' },
  { db: 100, minutes: 15, label: '15 min' },
  { db: 103, minutes: 7.5, label: '7.5 min' },
  { db: 106, minutes: 3.75, label: 'Under 4 min' },
];

// Cobalt at 85 dBA, amber at 106: the colour of each bar.
const tone = (i: number) =>
  `fill: color-mix(in oklab, var(--art-warm) ${Math.round((i / (rows.length - 1)) * 100)}%, var(--art-accent))`;

function chart(o: { label: number; x0: number; width: number; top: number; step: number; bar: number }) {
  const len = (m: number) => Math.max(2, (m / 480) * o.width);
  return { ...o, len };
}
const W = chart({ label: 30, x0: 120, width: 470, top: 74, step: 36, bar: 18 });
const N = chart({ label: 16, x0: 82, width: 170, top: 76, step: 40, bar: 18 });

const desc =
  'A bar chart of safe daily exposure under the NIOSH guideline. 85 dBA: 8 hours. 88 dBA: 4 hours. 91 dBA: 2 hours. 94 dBA: 1 hour. 97 dBA: 30 minutes. 100 dBA: 15 minutes. 103 dBA: 7.5 minutes. 106 dBA: under 4 minutes. Each step of 3 dB halves the time, and the bars shrink and turn from blue to amber.';
---

<Diagram caption="Under the NIOSH guideline, every 3 dB louder burns your daily bundle twice as fast.">
  <svg viewBox="0 0 720 390" width="720" height="390" role="img" aria-labelledby="bundle-w-t bundle-w-d">
    <title id="bundle-w-t">Your daily sound bundle</title>
    <desc id="bundle-w-d">{desc}</desc>
    <text class="t t-small" x={W.label} y="36">Level</text>
    <text class="t t-small" x={W.x0} y="36">Safe listening time per day (NIOSH)</text>
    {
      [0, 2, 4, 6, 8].map((h) => (
        <g>
          <path class="s-line" d={`M${W.x0 + (h / 8) * W.width} 52 V ${W.top + rows.length * W.step - 8}`} stroke-width="1" stroke-dasharray={h === 0 ? undefined : '2 4'} />
          <text class="t t-small" x={W.x0 + (h / 8) * W.width} y={W.top + rows.length * W.step + 12} text-anchor="middle">
            {h === 0 ? '0' : `${h} h`}
          </text>
        </g>
      ))
    }
    {
      rows.map((r, i) => {
        const y = W.top + i * W.step;
        return (
          <g>
            <text class="t t-strong" x={W.label} y={y + 13}>
              {r.db} dBA
            </text>
            <rect x={W.x0} y={y} width={W.len(r.minutes)} height={W.bar} rx="3" style={tone(i)} />
            <text class:list={['t', { 't-warm': r.db >= 100 }]} x={W.x0 + W.len(r.minutes) + 10} y={y + 14}>
              {r.label}
            </text>
          </g>
        );
      })
    }
  </svg>

  <svg slot="narrow" viewBox="0 0 340 440" width="340" height="440" role="img" aria-labelledby="bundle-n-t bundle-n-d">
    <title id="bundle-n-t">Your daily sound bundle</title>
    <desc id="bundle-n-d">{desc}</desc>
    <text class="t t-small" x={N.label} y="30">Level</text>
    <text class="t t-small" x={N.x0} y="30">Safe time per day (NIOSH)</text>
    {
      [0, 4, 8].map((h) => (
        <g>
          <path class="s-line" d={`M${N.x0 + (h / 8) * N.width} 48 V ${N.top + rows.length * N.step - 10}`} stroke-width="1" stroke-dasharray={h === 0 ? undefined : '2 4'} />
          <text class="t t-small" x={N.x0 + (h / 8) * N.width} y={N.top + rows.length * N.step + 10} text-anchor="middle">
            {h === 0 ? '0' : `${h} h`}
          </text>
        </g>
      ))
    }
    {
      rows.map((r, i) => {
        const y = N.top + i * N.step;
        return (
          <g>
            <text class="t t-strong" x={N.label} y={y + 13}>
              {r.db} dBA
            </text>
            <rect x={N.x0} y={y} width={N.len(r.minutes)} height={N.bar} rx="3" style={tone(i)} />
            <text class:list={['t', { 't-warm': r.db >= 100 }]} x={N.x0 + N.len(r.minutes) + 8} y={y + 14}>
              {r.label}
            </text>
          </g>
        );
      })
    }
  </svg>
</Diagram>
