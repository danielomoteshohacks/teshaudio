---
/**
 * One panel of the stereo vs spatial drawing, in its own 340 x 290 space
 * starting at (x, y). Used twice per drawing by StereoVsSpatial.astro.
 */
import ListenerHead from './ListenerHead.astro';

interface Props {
  kind: 'stereo' | 'spatial';
  x?: number;
  y?: number;
}

const { kind, x = 0, y = 0 } = Astro.props;
const stereo = kind === 'stereo';
---

<g transform={`translate(${x} ${y})`}>
  <text class="t t-strong" x="20" y="28">{stereo ? 'Stereo' : 'Spatial'}</text>
  <text class="t t-small" x="20" y="48">{stereo ? 'A line between your ears' : 'A room around you'}</text>

  {
    stereo ? (
      <>
        <ListenerHead x={170} y={170} />
        {/* Drawn over the head: stereo places the music inside it. */}
        <line class="s-accent" x1="58" y1="170" x2="282" y2="170" stroke-width="1.5" />
        <circle class="f-accent" cx="58" cy="170" r="5" />
        <circle class="f-accent" cx="170" cy="170" r="5" />
        <circle class="f-accent" cx="282" cy="170" r="5" />
        <text class="t" x="58" y="198" text-anchor="middle">Keys</text>
        <text class="t" x="170" y="226" text-anchor="middle">Vocal</text>
        <text class="t" x="282" y="198" text-anchor="middle">Drums</text>
      </>
    ) : (
      <>
        <rect class="s-line" x="22" y="64" width="296" height="214" rx="16" stroke-width="1.25" stroke-dasharray="3 5" />
        {/* Reflections returning off the walls. */}
        <g class="s-warm" stroke-width="1.25" stroke-linecap="round">
          <path d="M40 92 q12 -9 26 -14" />
          <path d="M40 104 q18 -14 38 -21" />
          <path d="M300 92 q-12 -9 -26 -14" />
          <path d="M300 104 q-18 -14 -38 -21" />
          <path d="M40 260 q12 7 26 10" />
          <path d="M300 260 q-12 7 -26 10" />
        </g>
        <ListenerHead x={170} y={192} />
        <circle class="f-accent" cx="170" cy="96" r="5" />
        <circle class="f-accent" cx="170" cy="138" r="5" />
        <circle class="f-accent" cx="66" cy="184" r="5" />
        <circle class="f-accent" cx="274" cy="184" r="5" />
        <circle class="f-accent" cx="112" cy="252" r="5" />
        <text class="t" x="182" y="101">Drums</text>
        <text class="t" x="182" y="143">Vocal</text>
        <text class="t" x="66" y="210" text-anchor="middle">Backing</text>
        <text class="t" x="274" y="210" text-anchor="middle">Backing</text>
        <text class="t" x="124" y="257">Keys</text>
        <text class="t t-warm" x="304" y="134" text-anchor="end">Reverb</text>
      </>
    )
  }
</g>
