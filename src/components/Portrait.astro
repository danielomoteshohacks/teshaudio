---
/**
 * Portrait
 *
 * Tesh's portrait from src/assets/portrait.jpg (prepared from the original
 * by scripts/prepare-portrait.mjs), as AVIF and WebP at several widths, in
 * a rounded frame with a hairline edge. No filters or effects: the photo is
 * shown as it is.
 *
 * size:
 *   "hero"   large and tall, with the static key light behind it (Home, About)
 *   "small"  a round avatar for bylines and the author note
 */
import { Picture } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import { site } from '../lib/site';

interface Props {
  size?: 'hero' | 'small';
  /** CSS width the image occupies, so the browser picks the right file. */
  sizes?: string;
  /** Above-the-fold portraits load first. */
  priority?: boolean;
  class?: string;
}

const { size = 'hero', sizes, priority = false, class: className } = Astro.props;
const small = size === 'small';
---

<div class:list={['portrait', `portrait--${size}`, className]}>
  <Picture
    src={portrait}
    alt={small ? '' : `Portrait of ${site.fullName} (${site.name}) in a blue embroidered native outfit`}
    formats={['avif', 'webp']}
    widths={small ? [96, 192] : [480, 720, 960, 1280, 1600]}
    sizes={sizes ?? (small ? '48px' : '(min-width: 64rem) 32rem, 100vw')}
    quality={small ? 70 : 80}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
</div>

<style>
  .portrait {
    position: relative;
    isolation: isolate;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait--hero :global(picture) {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-xl);
    /* A hairline of light on the frame edge, like a print behind glass. */
    outline: 1px solid color-mix(in oklab, var(--color-text) 10%, transparent);
    outline-offset: -1px;
    background-color: var(--color-bg-3);
  }

  /* The one static light: a soft studio key light behind and above the
     frame, as if the portrait were lit from the top left. A plain radial
     gradient: no animation, no blur filter. */
  .portrait--hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -18% -22% -10% -28%;
    pointer-events: none;
    background: radial-gradient(closest-side at 38% 34%, var(--key-light), transparent);
  }

  .portrait--small {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
  }

  /* The face sits in the upper half of the 4:5 photo. */
  .portrait--small :global(img) {
    object-position: 50% 28%;
  }

  .portrait--small :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-pill);
  }
</style>
