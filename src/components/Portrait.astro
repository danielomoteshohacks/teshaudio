---
/**
 * Portrait
 *
 * Tesh's portrait as AVIF and WebP at several widths, in a rounded frame.
 * Every width is prepared ahead of time by scripts/prepare-portrait.mjs
 * (src/assets/portrait/<crop>-<width>.jpg): the striped shirt aliases into
 * moire if a width is resampled carelessly, so each one is resampled once,
 * checked by eye, and the build only re-encodes it at its own width.
 *
 * size:
 *   "hero"   4:5, large, with the studio key light behind it (Home, About).
 *            It morphs between Home and About as a shared element (the
 *            view transition name "portrait"), and drifts a few pixels
 *            inside its frame as the page scrolls (motion.ts).
 *   "small"  a round avatar, tight on the face, for bylines and the author note
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../lib/site';

interface Props {
  size?: 'hero' | 'small';
  /** CSS width the image occupies, so the browser picks the right file. */
  sizes?: string;
  /** Above-the-fold portraits load first. */
  priority?: boolean;
  class?: string;
}

const { size = 'hero', sizes, priority = false, class: className } = Astro.props;
const small = size === 'small';
const crop = small ? 'avatar' : 'hero';

// The prepared files for this crop, by width. Only the widths a use needs:
// the 440px avatar exists for the share images, not for the page.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait/*.jpg', { eager: true });
const masters = Object.entries(files)
  .map(([path, mod]) => ({ name: path.split('/').pop()!, image: mod.default }))
  .filter(({ name }) => name.startsWith(`${crop}-`))
  .map(({ image }) => image)
  .filter((image) => !small || image.width <= 192)
  .sort((a, b) => a.width - b.width);

const quality = small ? 70 : 78;
// Each master is encoded at its own width: no second resample.
const encode = (format: 'avif' | 'webp') =>
  Promise.all(masters.map((src) => getImage({ src, width: src.width, format, quality })));
const [avif, webp] = await Promise.all([encode('avif'), encode('webp')]);
const srcset = (images: typeof avif) => images.map((img, i) => `${img.src} ${masters[i].width}w`).join(', ');

const largest = masters[masters.length - 1];
const fallback = webp[Math.min(1, webp.length - 1)];
const sizesAttr = sizes ?? (small ? '48px' : '(min-width: 64rem) 30rem, 100vw');
---

<div
  class:list={['portrait', `portrait--${size}`, className]}
  transition:name={small ? undefined : 'portrait'}
  data-parallax={small ? undefined : ''}
>
  <picture>
    <source type="image/avif" srcset={srcset(avif)} sizes={sizesAttr} />
    <source type="image/webp" srcset={srcset(webp)} sizes={sizesAttr} />
    <img
      src={fallback.src}
      width={largest.width}
      height={largest.height}
      alt={small ? '' : `Portrait of ${site.fullName} (${site.name}) in a striped shirt`}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
    />
  </picture>
</div>

<style>
  .portrait {
    position: relative;
    isolation: isolate;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait--hero picture {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-xl);
    background-color: var(--color-bg-3);
  }

  /* The image is a touch larger than its frame, so the scroll drift
     (--parallax, a few pixels, set by motion.ts) never shows an edge. */
  .portrait--hero img {
    transform: translate3d(0, var(--parallax, 0px), 0) scale(1.04);
  }

  /* The frame edge, drawn over the photo. Light mode: a hairline in the
     strong line colour, so the off-white wall in the photo does not melt
     into the off-white page. Dark mode: a faint light edge, like a print
     behind glass. */
  .portrait--hero::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--portrait-edge);
    border-radius: var(--radius-xl);
    pointer-events: none;
  }

  /* The studio key light: a soft light behind and above the frame, as if
     the portrait were lit from the top left. In dark mode it is what makes
     the bright photo look lit on purpose rather than like a hole in the
     page. A static radial gradient: no animation, no blur filter. */
  .portrait--hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -18% -22% -10% -28%;
    pointer-events: none;
    background: radial-gradient(closest-side at 38% 34%, var(--key-light), transparent);
  }

  .portrait--small {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
  }

  .portrait--small picture {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-pill);
    box-shadow: 0 0 0 1px var(--portrait-edge);
  }
</style>
