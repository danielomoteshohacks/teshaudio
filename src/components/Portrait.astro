---
/**
 * Portrait
 *
 * Tesh's portrait from src/assets/portrait.jpg, optimised by Astro into AVIF
 * and WebP at several widths. Explicit width and height (via the aspect
 * ratio) reserve the space before the image loads, so nothing shifts.
 * Replacing the file is the only step needed to swap in a real photo.
 */
import { Picture } from 'astro:assets';
import sharp from 'sharp';
import { join } from 'node:path';
import portrait from '../assets/portrait.jpg';
import { site } from '../lib/site';

// Blur-up: a 20px-wide version of the portrait, inlined as base64 (a few
// hundred bytes) and shown blurred behind the real image. The page opens on a
// soft impression of the photo that the sharp image then covers as it loads,
// with no JavaScript and no layout shift. Read from the project root because
// at build time this file runs from a compiled chunk.
const preview = await sharp(join(process.cwd(), 'src', 'assets', 'portrait.jpg'))
  .resize(20)
  .webp({ quality: 40 })
  .toBuffer();
const previewUrl = `url(data:image/webp;base64,${preview.toString('base64')})`;

interface Props {
  /** The CSS width the image occupies, so the browser picks the right file. */
  sizes: string;
  /** The hero portrait is the largest image above the fold: load it first. */
  priority?: boolean;
}

const { sizes, priority = false } = Astro.props;
---

<div class="portrait" style={`--preview: ${previewUrl}`}>
  <Picture
    src={portrait}
    alt={`Portrait of ${site.fullName} (${site.name})`}
    formats={['avif', 'webp']}
    widths={[400, 640, 880, 1200]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
</div>

<style>
  .portrait {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-raised);
    box-shadow: var(--shadow-2);
  }

  /* The blurred preview, scaled up slightly so the blur has no soft edge. */
  .portrait::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--preview) center / cover no-repeat;
    filter: blur(18px);
    transform: scale(1.1);
  }

  .portrait :global(img) {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Where supported, the sharp image fades in over the preview as it
     decodes. Skipped under reduced motion: it simply appears. */
  @media (prefers-reduced-motion: no-preference) {
    .portrait :global(img) {
      animation: sharpen var(--duration-slow) var(--ease-out) both;
    }
  }

  @keyframes sharpen {
    from {
      opacity: 0;
      filter: blur(8px);
    }
  }
</style>
