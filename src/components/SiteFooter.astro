---
/**
 * SiteFooter
 *
 * A generous closing band: the name set large, a one-line description, the
 * navigation and the ways to get in touch (only those set in site.ts), then
 * the copyright. The year is taken at build time, which is accurate because
 * every deploy rebuilds the site.
 */
import Waveform from './Waveform.astro';
import { nav, site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__wave"><Waveform seed={7} /></div>
    <div class="footer__grid">
      <div class="footer__identity">
        <a class="footer__name" href="/">{site.fullName}</a>
        <p class="footer__line">Music producer and composer. {site.city}.</p>
      </div>

      <nav class="footer__col" aria-label="Footer">
        <p class="footer__label">Site</p>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a class="slide-link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer__col">
        <p class="footer__label">Elsewhere</p>
        <ul>
          {
            site.socials.map((social) => (
              <li>
                <a class="slide-link" href={social.url} rel="me noopener">
                  {social.label}
                </a>
              </li>
            ))
          }
          {
            site.email && (
              <li>
                <a class="slide-link footer__email" href={`mailto:${site.email}`}>
                  {site.email}
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <p class="footer__base">&copy; {year} {site.fullName}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section-gap);
    padding-bottom: var(--space-10);
    border-top: 1px solid var(--color-line);
  }

  /* After a full-bleed band (Home's beliefs) the band itself is the break,
     so the footer follows it directly instead of leaving an empty strip. */
  :global(main:has(> .band-last:last-child)) + .footer {
    margin-top: 0;
    border-top: 0;
  }

  .footer__wave {
    margin-block: var(--space-12) var(--space-12);
  }

  .footer__grid {
    display: grid;
    gap: var(--space-10) var(--space-8);
    grid-template-columns: 1fr 1fr;
  }

  .footer__identity {
    grid-column: 1 / -1;
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  /* Three columns only once the address fits its column on one line. */
  @media (min-width: 64rem) {
    .footer__grid {
      grid-template-columns: 2fr 1fr 1fr;
    }

    .footer__identity {
      grid-column: auto;
    }
  }

  .footer__name {
    justify-self: start;
    font-size: var(--step-3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    color: var(--color-text);
    text-decoration: none;
  }

  .footer__line {
    color: var(--color-text-2);
  }

  .footer__label {
    margin-bottom: var(--space-3);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--color-text-3);
  }

  .footer__col ul {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .footer__col a {
    display: inline-block;
    padding-block: var(--space-2);
    line-height: 1.3;
  }

  /* The address is long. On narrow phones "Elsewhere" takes its own row so
     the address stays on one line; it may still wrap rather than ever push
     the page sideways. */
  .footer__email {
    overflow-wrap: anywhere;
  }

  @media (max-width: 29.99rem) {
    .footer__col:last-child {
      grid-column: 1 / -1;
    }
  }

  .footer__base {
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
    font-size: var(--step--1);
    color: var(--color-text-3);
  }
</style>
