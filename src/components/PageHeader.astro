---
/**
 * PageHeader
 *
 * The opening block of every inner page: mono eyebrow, a large headline and
 * an optional lead. Left-aligned on inner pages (it sits above lists and
 * long text, which also read left to right); Home has its own hero.
 * Extra content (filters, metadata) goes in the default slot.
 */
import Container from './Container.astro';
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="page-header">
  <Container>
    <div class="page-header__inner glow">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <h1 class="page-header__title">{title}</h1>
      {lead && <p class="page-header__lead">{lead}</p>}
      <slot />
    </div>
  </Container>
</header>

<style>
  .page-header {
    position: relative;
    isolation: isolate;
    padding-block: clamp(var(--space-16), 10vw, var(--space-32)) clamp(var(--space-10), 6vw, var(--space-20));
  }

  .page-header__inner {
    display: grid;
    gap: var(--space-5);
    max-width: 48rem;
  }

  .page-header__title {
    font-size: var(--step-6);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .page-header__lead {
    max-width: 36rem;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }
</style>
