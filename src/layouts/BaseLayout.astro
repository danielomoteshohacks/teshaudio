---
/**
 * BaseLayout: the shell every page renders inside.
 *
 * Owns the <head> (title, description, canonical, Open Graph, JSON-LD), the
 * fonts and global CSS, the skip link, header and footer. Navigation goes
 * through Astro's ClientRouter for a quiet crossfade between pages.
 */
// Variable fonts: one file per family covers every weight. Fontsource bundles
// them with the build, so no request ever goes to a third-party font CDN.
// Inter's opsz build adds the optical-size axis (display-tuned letterforms at
// headline sizes). It costs about 24 KB more than the weight-only build.
import '@fontsource-variable/inter/opsz.css';
// Order matters: tokens define the custom properties global.css consumes.
import '../styles/tokens.css';
import '../styles/global.css';
// Preloading the Latin Inter file lets the browser fetch it in parallel with
// the CSS instead of discovering it afterwards, so headlines render sooner.
import interLatin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../lib/site';

interface Props {
  /** Page title. Omit on Home to use the full site title. */
  title?: string;
  description?: string;
  /** Keeps a page out of search results (unlisted articles). */
  noindex?: boolean;
  /** Which Open Graph card to use; defaults to one derived from the URL. */
  ogKey?: string;
  ogType?: 'website' | 'article';
  /** Structured data (schema.org) emitted as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  noindex = false,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : site.title;

// Canonical URL tells search engines which address is the real one, avoiding
// duplicate-content issues (for example trailing slash vs none).
const canonical = new URL(Astro.url.pathname, Astro.site);

// "/projects/acoustimorph/" -> "projects/acoustimorph"; "/" -> "home".
const ogKey = Astro.props.ogKey ?? (Astro.url.pathname.replace(/^\/|\/$/g, '') || 'home');
const ogImage = new URL(`/og/${ogKey}.png`, Astro.site);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {/* Both schemes are supported; the inline script below picks one. */}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0c12" media="(prefers-color-scheme: dark)" />
    {/* Sets data-mode on <html> before first paint, so there is never a flash
        of the wrong theme. Order: the visitor's saved choice, else their OS
        setting. It also sets data-motion="on" when motion is allowed, which
        is what lets scroll reveals hide content until it enters (so without
        JavaScript nothing is ever hidden). Inline and render-blocking on
        purpose: it is tiny, and it must run before the body is drawn.
        ClientRouter replaces <html> attributes on every navigation, so it
        re-applies after each swap. The header toggle (SiteHeader.astro) is
        wired here too, with one delegated listener, because the header is
        re-rendered on every page. The toggle reveals the new theme in a
        circle growing from the button (View Transitions), or crossfades
        colours where that API is missing. */}
    <script is:inline>
      (() => {
        const key = 'tesh-mode';
        const media = matchMedia('(prefers-color-scheme: dark)');
        const saved = () => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        };
        const current = () => saved() || (media.matches ? 'dark' : 'light');
        const still = matchMedia('(prefers-reduced-motion: reduce)');
        const root = document.documentElement;
        const apply = () => {
          const mode = current();
          root.dataset.mode = mode;
          if (still.matches) delete root.dataset.motion;
          else root.dataset.motion = 'on';
          document.querySelectorAll('[data-mode-toggle]').forEach((button) => {
            button.setAttribute('aria-pressed', String(mode === 'dark'));
          });
        };
        apply();
        if (window.__teshMode) return;
        window.__teshMode = true;
        document.addEventListener('astro:after-swap', apply);
        document.addEventListener('DOMContentLoaded', apply);
        media.addEventListener('change', () => {
          if (!saved()) apply();
        });
        still.addEventListener('change', apply);
        document.addEventListener('click', (event) => {
          const button = event.target.closest('[data-mode-toggle]');
          if (!button) return;
          const next = root.dataset.mode === 'dark' ? 'light' : 'dark';
          const toggle = () => {
            try {
              localStorage.setItem(key, next);
            } catch {}
            apply();
          };
          if (still.matches) return toggle();
          if (!document.startViewTransition) {
            root.dataset.themeFade = '';
            toggle();
            setTimeout(() => delete root.dataset.themeFade, 520);
            return;
          }
          const box = button.getBoundingClientRect();
          const x = box.left + box.width / 2;
          const y = box.top + box.height / 2;
          const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
          root.dataset.themeSwitch = '';
          const transition = document.startViewTransition(toggle);
          transition.ready.then(() => {
            root.animate(
              { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
              { duration: 560, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', pseudoElement: '::view-transition-new(root)' },
            );
          });
          transition.finished.finally(() => delete root.dataset.themeSwitch);
        });
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: Writing`} href="/rss.xml" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    {/* Open Graph and Twitter cards: what WhatsApp, LinkedIn and X show when a
        link is shared. The image is generated at build time per page. */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
