---
/**
 * Philosophy: one long-form essay in four parts, typeset like a printed
 * essay (narrow measure, generous leading, numbered parts), not a grid of
 * cards. Each part is its own MDX file in src/content/philosophy/.
 */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { getPhilosophySections } from '../lib/content';
import { copy, site } from '../lib/site';
import '../styles/prose.css';

const sections = await Promise.all(
  (await getPhilosophySections()).map(async (entry) => ({ entry, ...(await render(entry)) })),
);
---

<BaseLayout title="Philosophy" description={copy.philosophy.description}>
  <article class="essay">
    <Container width="narrow">
      <header class="essay__header">
        <Eyebrow>Philosophy</Eyebrow>
        <h1 class="essay__title">{copy.philosophy.title}</h1>
        <p class="essay__lead">{site.philosophyQuote}</p>
        <nav aria-label="Parts of the essay">
          <ol class="essay__parts">
            {
              sections.map(({ entry }, i) => (
                <li>
                  <a href={`#${entry.id}`}>
                    <span class="meta">{String(i + 1).padStart(2, '0')}</span>
                    {entry.data.title}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </header>

      {
        sections.map(({ entry, Content }, i) => (
          <section class="essay__part" id={entry.id} aria-labelledby={`${entry.id}-title`}>
            <Eyebrow>
              Part {String(i + 1).padStart(2, '0')} of {String(sections.length).padStart(2, '0')}
            </Eyebrow>
            <h2 id={`${entry.id}-title`} class="essay__part-title">
              {entry.data.title}
            </h2>
            <div class="prose essay__prose">
              <Content />
            </div>
          </section>
        ))
      }
    </Container>
  </article>
</BaseLayout>

<style>
  .essay {
    padding-block: clamp(var(--space-16), 10vw, var(--space-32)) var(--space-24);
  }

  .essay__header {
    display: grid;
    gap: var(--space-6);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--color-border);
  }

  .essay__title {
    font-size: var(--step-5);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .essay__lead {
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-muted);
    text-wrap: balance;
  }

  .essay__parts {
    display: grid;
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .essay__parts a {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    min-height: 44px;
    padding-block: var(--space-2);
    color: var(--color-text);
    text-decoration: none;
  }

  .essay__parts a:hover {
    color: var(--color-accent);
  }

  .essay__part {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--color-border);
  }

  .essay__part:last-child {
    border-bottom: 0;
  }

  .essay__part-title {
    font-size: var(--step-4);
  }

  /* Essay text reads slightly larger than article text: it is meant to be
     read slowly, start to finish. */
  .essay__prose {
    margin-top: var(--space-4);
    font-size: var(--step-1);
    line-height: 1.65;
  }
</style>
