---
/**
 * Home.
 *
 * Order: hero, lead story, now, disciplines, featured listening (only once a
 * published track is featured), what I'm building, philosophy quote, more
 * writing, ideas, lab (only once a lab entry is published), contact.
 *
 * The page is built as a few movements rather than a stack of identical
 * cards: a cinematic hero, one big editorial story, a full-width statement,
 * a typographic list, then a dark band for the work and the quote. Sections
 * with nothing real in them are left out entirely, so the page never shows
 * an empty shelf.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import Portrait from '../components/Portrait.astro';
import CoverArt from '../components/CoverArt.astro';
import SectionIntro from '../components/SectionIntro.astro';
import TrackRow from '../components/TrackRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WritingRow from '../components/WritingRow.astro';
import { copy, site } from '../lib/site';
import { ideas } from '../data/ideas';
import { personSchema } from '../lib/schema';
import { formatDate, isoDate, kindLabel, readingTime, statusLabel } from '../lib/format';
import { getPhoto } from '../lib/photos';
import {
  getPublishedLab,
  getPublishedProjects,
  getPublishedTracks,
  getPublishedWriting,
} from '../lib/content';

const tracks = (await getPublishedTracks()).filter((t) => t.data.featured).slice(0, 3);
const projects = (await getPublishedProjects()).filter((p) => p.data.featured);
const allWriting = await getPublishedWriting();
const lab = await getPublishedLab();
const projectTitles = new Map((await getPublishedProjects()).map((p) => [p.id, p.data.title]));

// The lead story is the newest essay; the rest of the writing follows lower
// down. If no essay exists, the section simply does not render.
const lead = allWriting.find((entry) => entry.data.kind === 'essay');
const leadCover = lead?.data.cover ? getPhoto(lead.data.cover.file) : undefined;
const moreWriting = allWriting.filter((entry) => entry !== lead).slice(0, 3);

// Section numbers follow the sections actually shown, so hiding one never
// leaves a gap in the sequence.
let n = 0;
const next = () => String(++n).padStart(2, '0');
---

<BaseLayout jsonLd={personSchema()}>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    {/* The stage: slow drifting cobalt and amber light, a soft beam and film
        grain. Decorative layers only, painted behind the content. */}
    <div class="hero__stage" aria-hidden="true">
      <span class="hero__light hero__light--cobalt"></span>
      <span class="hero__light hero__light--amber"></span>
      <span class="hero__beam"></span>
      <span class="hero__grain"></span>
    </div>

    <Container>
      <div class="hero__grid">
        <div class="hero__text">
          <p class="hero__eyebrow">
            <span>{site.fullName}</span>
            <span class="hero__dot" aria-hidden="true"></span>
            <span>{site.location}</span>
          </p>
          <h1 id="hero-title" class="hero__name">{site.name}</h1>
          <p class="hero__role">{site.roleStatement}</p>
          <p class="hero__intro">{site.intro}</p>
          <div class="hero__actions">
            {lead && <Button size="lg" href={`/writing/${lead.id}/`}>{copy.home.lead.cta}</Button>}
            <Button size="lg" variant="secondary" href="/projects/">View work</Button>
            <Button size="lg" variant="ghost" href="/about/">About me</Button>
          </div>
        </div>
        <div class="hero__portrait">
          <Portrait priority sizes="(min-width: 64rem) 30rem, (min-width: 48rem) 40vw, calc(100vw - 4rem)" />
        </div>
      </div>
    </Container>
  </section>

  <!-- Lead story -->
  {
    lead && (
      <Section aria-labelledby="lead-title" class="lead-section">
        <Container>
          <Eyebrow index={next()}>{copy.home.lead.eyebrow}</Eyebrow>
          <a class="lead reveal" href={`/writing/${lead.id}/`}>
            <div class="lead__media">
              {leadCover && lead.data.cover ? (
                <Image
                  src={leadCover}
                  alt={lead.data.cover.alt}
                  widths={[480, 720, 960, 1280]}
                  sizes="(min-width: 64rem) 40rem, 100vw"
                  quality={76}
                />
              ) : (
                <CoverArt id="lead-cover" />
              )}
            </div>
            <div class="lead__body">
              <p class="lead__meta meta">
                <span>{kindLabel[lead.data.kind]}</span>
                <span aria-hidden="true">·</span>
                <span>{readingTime(lead.body)}</span>
                <span aria-hidden="true">·</span>
                <time datetime={isoDate(lead.data.pubDate)}>{formatDate(lead.data.pubDate)}</time>
              </p>
              <h2 id="lead-title" class="lead__title">{lead.data.title}</h2>
              <p class="lead__subtitle">{lead.data.description}</p>
              <span class="lead__cta" aria-hidden="true">
                {copy.home.lead.cta}
                <svg width="16" height="16" viewBox="0 0 14 14">
                  <path d="M3 7h8M7.5 3.5L11 7l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>
          </a>
        </Container>
      </Section>
    )
  }

  <!-- Now: one full-width statement -->
  {
    site.now.length > 0 && (
      <section class="now" aria-labelledby="now-title">
        <Container>
          <div class="now__inner reveal">
            <h2 id="now-title" class="now__label">
              <span class="now__dot" aria-hidden="true" />
              {copy.home.now.title}
            </h2>
            <ul class="now__list">
              {site.now.map((item) => (
                <li>{item.href ? <a href={item.href}>{item.text}</a> : item.text}</li>
              ))}
            </ul>
          </div>
        </Container>
      </section>
    )
  }

  <!-- Disciplines: an editorial list, not a grid of boxes -->
  <Section aria-labelledby="disciplines-title">
    <Container>
      <SectionIntro eyebrow={copy.home.disciplines.eyebrow} index={next()} id="disciplines-title" title={copy.home.disciplines.title} />
      <ol class="disciplines">
        {
          site.disciplines.map((discipline, i) => (
            <li class="discipline reveal" style={`--stagger: ${i % 3}`}>
              <span class="discipline__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="discipline__title">{discipline.title}</h3>
              <p class="discipline__summary">{discipline.summary}</p>
            </li>
          ))
        }
      </ol>
    </Container>
  </Section>

  <!-- Featured listening: hidden until a published track is featured -->
  {
    tracks.length > 0 && (
      <Section theme="dark" aria-labelledby="listening-title">
        <Container class="reveal">
          <SectionIntro
            eyebrow={copy.home.listening.eyebrow}
            index={next()}
            id="listening-title"
            title={copy.home.listening.title}
            lead={copy.home.listening.lead}
            link={{ label: 'All music', href: '/music/' }}
          />
          <div class="tracks">
            {tracks.map((track, i) => (
              <TrackRow track={track} index={i + 1} />
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  <!-- What I'm building -->
  {
    projects.length > 0 && (
      <Section theme="dark" aria-labelledby="building-title" class="band">
        <Container>
          <SectionIntro
            eyebrow={copy.home.building.eyebrow}
            index={next()}
            id="building-title"
            title={copy.home.building.title}
            link={{ label: 'All work', href: '/projects/' }}
          />
          <ul class="cards cards--two">
            {projects.map((project, i) => (
              <li class="reveal" style={`--stagger: ${i}`}>
                <ProjectCard project={project} />
              </li>
            ))}
          </ul>
        </Container>
      </Section>
    )
  }

  <!-- Philosophy quote -->
  <Section theme="dark" aria-labelledby="philosophy-title" spacing="flush-top">
    <Container class="reveal">
      <div class="quote glow">
        <Eyebrow index={next()}>Philosophy</Eyebrow>
        <h2 id="philosophy-title" class="visually-hidden">Philosophy</h2>
        <figure>
          <blockquote class="quote__text">
            <p>{site.philosophyQuote}</p>
          </blockquote>
        </figure>
        <Button variant="secondary" href="/philosophy/">How I think about sound</Button>
      </div>
    </Container>
  </Section>

  <!-- More writing (after the lead story) -->
  {
    moreWriting.length > 0 && (
      <Section aria-labelledby="writing-title">
        <Container class="reveal">
          <SectionIntro
            eyebrow={copy.home.writing.eyebrow}
            index={next()}
            id="writing-title"
            title={copy.home.writing.title}
            link={{ label: 'All writing', href: '/writing/' }}
          />
          <div class="writing">
            {moreWriting.map((entry) => (
              <WritingRow entry={entry} />
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  <!-- Ideas -->
  <Section aria-labelledby="ideas-title" spacing={moreWriting.length > 0 ? 'flush-top' : 'default'}>
    <Container>
      <SectionIntro
        eyebrow={copy.home.ideas.eyebrow}
        index={next()}
        id="ideas-title"
        title={copy.home.ideas.title}
        link={{ label: 'All ideas', href: '/ideas/' }}
      />
      <ul class="ideas">
        {
          ideas.map((idea, i) => (
            <li class="reveal" style={`--stagger: ${i % 2}`}>
              <div class="idea">
                <p class="meta">Idea</p>
                <h3 class="idea__title">{idea.title}</h3>
                <p class="idea__note">{idea.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  <!-- Lab: hidden until a lab entry is published -->
  {
    lab.length > 0 && (
      <Section aria-labelledby="lab-title" spacing="flush-top">
        <Container>
          <SectionIntro
            eyebrow={copy.home.lab.eyebrow}
            index={next()}
            id="lab-title"
            title={copy.home.lab.title}
            lead={copy.home.lab.lead}
            link={{ label: 'Visit the lab', href: '/lab/' }}
          />
          <ul class="cards cards--two">
            {lab.map((entry, i) => (
              <li class="reveal" style={`--stagger: ${i}`}>
                <Card href={`/lab/${entry.id}/`}>
                  <div class="lab-card">
                    <Badge tone={entry.data.status === 'live' ? 'accent' : 'neutral'} dot>
                      {statusLabel[entry.data.status]}
                    </Badge>
                    <h3 class="lab-card__title">{entry.data.title}</h3>
                    <p class="lab-card__summary">{entry.data.summary}</p>
                    {entry.data.relatedProject && (
                      <p class="meta">Project: {projectTitles.get(entry.data.relatedProject.id)}</p>
                    )}
                  </div>
                </Card>
              </li>
            ))}
          </ul>
        </Container>
      </Section>
    )
  }

  <!-- Contact -->
  <Section theme="dark" aria-labelledby="contact-title" class="contact-section">
    <Container class="reveal">
      <div class="contact glow">
        <Eyebrow index={next()}>{copy.home.contact.eyebrow}</Eyebrow>
        <h2 id="contact-title" class="contact__title">{copy.home.contact.title}</h2>
        {
          site.email && (
            <a class="contact__email" href={`mailto:${site.email}`}>
              {site.email}
            </a>
          )
        }
        {
          site.socials.length > 0 && (
            <ul class="contact__socials">
              {site.socials.map((social) => (
                <li>
                  <a href={social.url} rel="me noopener">
                    <span class="contact__social-label">{social.label}</span>
                    <span class="meta">@{social.handle}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  /* ===== Hero ==============================================================
   * Dark-first: a deep stage with two slow pools of light (cobalt, matched
   * to the portrait's outfit, and warm amber) drifting like stage lighting,
   * a faint diagonal beam and film grain. Light mode gets a warm daylight
   * version of the same scene. Everything is gradients on transformed
   * layers: no filters, no JavaScript, and the motion touches only
   * transform, so the compositor runs it without repainting.
   */
  .hero {
    --hero-base: var(--neutral-50);
    --hero-cobalt: color-mix(in srgb, var(--light-cobalt) 17%, transparent);
    --hero-amber: color-mix(in srgb, var(--light-amber) 30%, transparent);
    --hero-beam: color-mix(in srgb, var(--neutral-25) 70%, transparent);
    --hero-grain: 0.08;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(var(--space-10), 6vw, var(--space-20)) clamp(var(--space-16), 9vw, var(--space-32));
    background-color: var(--hero-base);
  }

  :global(:root[data-mode='dark']) .hero {
    --hero-base: var(--neutral-950);
    --hero-cobalt: color-mix(in srgb, var(--light-cobalt) 50%, transparent);
    --hero-amber: color-mix(in srgb, var(--light-amber) 20%, transparent);
    --hero-beam: color-mix(in srgb, var(--accent-on-dark) 10%, transparent);
    --hero-grain: 0.11;
  }

  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  /* Each pool of light is an oversized radial gradient on its own layer. */
  .hero__light {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  .hero__light--cobalt {
    width: 110vmax;
    height: 110vmax;
    right: -38vmax;
    top: -30vmax;
    background: radial-gradient(closest-side, var(--hero-cobalt), transparent);
  }

  .hero__light--amber {
    width: 90vmax;
    height: 90vmax;
    left: -40vmax;
    bottom: -52vmax;
    background: radial-gradient(closest-side, var(--hero-amber), transparent);
  }

  /* A soft beam falling from the top left, like a spot through haze. */
  .hero__beam {
    position: absolute;
    top: -20%;
    left: 8%;
    width: 38%;
    height: 150%;
    background: linear-gradient(180deg, var(--hero-beam), transparent 70%);
    transform: rotate(-18deg);
    transform-origin: 50% 0;
    opacity: 0.7;
    will-change: transform;
  }

  .hero__grain {
    position: absolute;
    inset: 0;
    background-image: var(--grain-tile);
    background-size: 160px 160px;
    opacity: var(--hero-grain);
    mix-blend-mode: overlay;
  }

  /* The bottom edge dissolves into the page surface, so the hero flows into
     the next section instead of ending on a hard line. */
  .hero__stage::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: linear-gradient(transparent, var(--color-surface));
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__light--cobalt {
      animation: drift-a var(--duration-ambient) var(--ease-in-out) infinite alternate;
    }

    .hero__light--amber {
      animation: drift-b calc(var(--duration-ambient) * 1.3) var(--ease-in-out) infinite alternate;
    }

    .hero__beam {
      animation: sway calc(var(--duration-ambient) * 0.9) var(--ease-in-out) infinite alternate;
    }
  }

  @keyframes drift-a {
    to {
      transform: translate3d(-14vmax, 12vmax, 0) scale(1.08);
    }
  }

  @keyframes drift-b {
    to {
      transform: translate3d(22vmax, -10vmax, 0) scale(0.94);
    }
  }

  @keyframes sway {
    to {
      transform: rotate(-6deg) translateX(10%);
    }
  }

  .hero__grid {
    display: grid;
    gap: var(--space-10);
    align-items: center;
  }

  .hero__text {
    display: grid;
    gap: var(--space-5);
    /* The action row adapts to the width of this column, not the viewport:
       on tablets the column is narrow even though the screen is not. */
    container-type: inline-size;
  }

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero__dot {
    width: 5px;
    height: 5px;
    border-radius: var(--radius-pill);
    background-color: var(--color-warm);
  }

  .hero__name {
    margin-block: calc(var(--space-2) * -1) var(--space-1);
    font-size: var(--step-hero);
    font-weight: var(--weight-bold);
    line-height: 0.86;
    letter-spacing: -0.055em;
    /* Optical margin: big type's side bearing makes it look indented. */
    margin-left: -0.04em;
  }

  .hero__role {
    max-width: 32rem;
    font-size: var(--step-3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .hero__intro {
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  /* Narrow columns: the two main actions share the first row at equal width
     and the quiet third action sits centred beneath them. */
  @container (max-width: 30rem) {
    .hero__actions > :global(*) {
      flex: 1 1 0;
    }

    .hero__actions > :global(:last-child) {
      flex-basis: 100%;
    }
  }

  .hero__portrait {
    width: 100%;
    max-width: 26rem;
    justify-self: center;
    padding-inline: var(--space-4);
  }

  /* Phones: name and line first, then the portrait, then the rest, so the
     page opens on who this is and the face follows immediately. */
  @media (max-width: 47.99rem) {
    .hero__grid {
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }

    .hero__text {
      display: contents;
    }

    .hero__eyebrow { order: 1; }
    .hero__name { order: 2; }
    .hero__role { order: 3; margin-bottom: var(--space-4); }
    .hero__portrait { order: 4; margin-bottom: var(--space-6); }
    .hero__intro { order: 5; margin-bottom: var(--space-2); }
    .hero__actions { order: 6; }

    .hero__grid > * + * {
      margin-top: var(--space-4);
    }

    /* The container query above cannot reach the actions here (their
       column is display: contents on phones), so the same arrangement is
       repeated for the viewport. */
    .hero__actions > :global(*) {
      flex: 1 1 0;
    }

    .hero__actions > :global(:first-child) {
      flex-basis: 100%;
    }
  }

  @media (min-width: 48rem) {
    .hero {
      display: grid;
      align-items: center;
      min-height: min(56rem, calc(100svh - var(--header-height)));
    }

    .hero__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: clamp(var(--space-8), 6vw, var(--space-24));
    }

    .hero__portrait {
      max-width: 30rem;
      justify-self: end;
      padding: 0;
    }
  }

  /* ===== Lead story ======================================================= */
  .lead-section {
    padding-top: clamp(var(--space-8), 4vw, var(--space-16));
  }

  .lead {
    display: grid;
    margin-top: var(--space-6);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface-raised);
    box-shadow: var(--shadow-2);
    color: var(--color-text);
    text-decoration: none;
    transition:
      box-shadow var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out);
  }

  .lead:hover {
    box-shadow: var(--shadow-3);
    transform: translateY(-3px);
  }

  .lead:focus-visible {
    outline-offset: 4px;
  }

  .lead__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background-color: var(--neutral-950);
  }

  .lead__media :global(img),
  .lead__media :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .lead:hover .lead__media :global(img),
  .lead:hover .lead__media :global(svg) {
    transform: scale(1.03);
  }

  .lead__body {
    display: grid;
    align-content: center;
    gap: var(--space-5);
    padding: clamp(var(--space-6), 4vw, var(--space-16));
  }

  .lead__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .lead__title {
    font-size: var(--step-4);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .lead__subtitle {
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .lead__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
  }

  .lead__cta svg {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .lead:hover .lead__cta svg {
    transform: translateX(4px);
  }

  @media (min-width: 64rem) {
    .lead {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .lead__media {
      aspect-ratio: auto;
      min-height: 30rem;
    }
  }

  /* ===== Now ==============================================================
   * One full-width statement between hairlines, with the warm "on air" dot:
   * what is on the desk today. */
  .now {
    border-block: 1px solid var(--color-border);
    background:
      radial-gradient(ellipse 60% 140% at 0% 50%, color-mix(in oklab, var(--color-warm) 8%, transparent), transparent 70%),
      var(--color-surface-raised);
  }

  .now__inner {
    display: grid;
    gap: var(--space-5);
    padding-block: clamp(var(--space-12), 7vw, var(--space-24));
  }

  @media (min-width: 64rem) {
    .now__inner {
      grid-template-columns: 16rem 1fr;
      align-items: baseline;
    }
  }

  .now__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-warm);
  }

  .now__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background-color: currentColor;
    box-shadow: 0 0 0 4px color-mix(in oklab, currentColor 20%, transparent);
  }

  /* A slow "on air" pulse; still under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .now__dot {
