---
/**
 * Home.
 *
 * Order: hero, now, disciplines, featured listening (only once a published
 * track is featured), what I'm building, philosophy quote, latest writing,
 * ideas, lab, contact. Light and dark sections are grouped rather than
 * strictly alternated, so the page reads as a few calm movements.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import Portrait from '../components/Portrait.astro';
import SectionIntro from '../components/SectionIntro.astro';
import TrackRow from '../components/TrackRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WritingRow from '../components/WritingRow.astro';
import { copy, site } from '../lib/site';
import { ideas } from '../data/ideas';
import { personSchema } from '../lib/schema';
import { statusLabel } from '../lib/format';
import {
  getPublishedLab,
  getPublishedProjects,
  getPublishedTracks,
  getPublishedWriting,
} from '../lib/content';

const tracks = (await getPublishedTracks()).filter((t) => t.data.featured).slice(0, 3);
const projects = (await getPublishedProjects()).filter((p) => p.data.featured);
const writing = (await getPublishedWriting()).slice(0, 3);
const lab = await getPublishedLab();
const projectTitles = new Map((await getPublishedProjects()).map((p) => [p.id, p.data.title]));

// Section numbers follow the sections actually shown, so hiding one (for
// example Featured listening before any track exists) never leaves a gap.
let n = 0;
const next = () => String(++n).padStart(2, '0');
---

<BaseLayout jsonLd={personSchema()}>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <Container>
      <div class="hero__grid">
        <div class="hero__text glow">
          <Eyebrow>{site.location}</Eyebrow>
          <h1 id="hero-title" class="hero__name">{site.name}</h1>
          <p class="hero__role">{site.roleStatement}</p>
          <p class="hero__intro">{site.intro}</p>
          <div class="hero__actions">
            <Button size="lg" href="/projects/">View work</Button>
            <Button size="lg" variant="secondary" href="/writing/">Read writing</Button>
            <Button size="lg" variant="ghost" href="/about/">About me</Button>
          </div>
        </div>
        <div class="hero__portrait">
          <Portrait priority sizes="(min-width: 64rem) 30rem, (min-width: 40rem) 28rem, calc(100vw - 2rem)" />
        </div>
      </div>
    </Container>
  </section>

  <!-- Now -->
  <Section aria-labelledby="now-title" spacing="flush-top">
    <Container class="reveal">
      <div class="now">
        <div class="now__head">
          <p class="now__label">{copy.home.now.eyebrow}</p>
          <h2 id="now-title" class="now__title">{copy.home.now.title}</h2>
        </div>
        <ul class="now__list">
          {
            site.now.map((item) => (
              <li>{item.href ? <a href={item.href}>{item.text}</a> : item.text}</li>
            ))
          }
        </ul>
      </div>
    </Container>
  </Section>

  <!-- Disciplines -->
  <Section aria-labelledby="disciplines-title" spacing="flush-top">
    <Container>
      <SectionIntro eyebrow={copy.home.disciplines.eyebrow} index={next()} id="disciplines-title" title={copy.home.disciplines.title} />
      <ul class="disciplines">
        {
          site.disciplines.map((discipline, i) => (
            <li class="reveal" style={`--stagger: ${i % 3}`}>
              <Card as="div">
                <p class="disciplines__index meta">{String(i + 1).padStart(2, '0')}</p>
                <h3 class="disciplines__title">{discipline.title}</h3>
                <p class="disciplines__summary">{discipline.summary}</p>
              </Card>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  <!-- Featured listening: hidden until a published track is featured -->
  {
    tracks.length > 0 && (
      <Section theme="dark" aria-labelledby="listening-title">
        <Container class="reveal">
          <SectionIntro
            eyebrow={copy.home.listening.eyebrow}
            index={next()}
            id="listening-title"
            title={copy.home.listening.title}
            lead={copy.home.listening.lead}
            link={{ label: 'All music', href: '/music/' }}
          />
          <div class="tracks">
            {tracks.map((track, i) => (
              <TrackRow track={track} index={i + 1} />
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  <!-- What I'm building -->
  <Section theme="dark" aria-labelledby="building-title">
    <Container>
      <SectionIntro
        eyebrow={copy.home.building.eyebrow}
        index={next()}
        id="building-title"
        title={copy.home.building.title}
        link={{ label: 'All work', href: '/projects/' }}
      />
      <ul class="cards cards--two">
        {
          projects.map((project, i) => (
            <li class="reveal" style={`--stagger: ${i}`}>
              <ProjectCard project={project} />
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  <!-- Philosophy quote -->
  <Section theme="dark" aria-labelledby="philosophy-title" spacing="flush-top">
    <Container class="reveal">
      <div class="quote glow">
        <Eyebrow index={next()}>Philosophy</Eyebrow>
        <h2 id="philosophy-title" class="visually-hidden">Philosophy</h2>
        <figure>
          <blockquote class="quote__text">
            <p>{site.philosophyQuote}</p>
          </blockquote>
        </figure>
        <Button variant="secondary" href="/philosophy/">How I think about sound</Button>
      </div>
    </Container>
  </Section>

  <!-- Latest writing -->
  {
    writing.length > 0 && (
      <Section aria-labelledby="writing-title">
        <Container class="reveal">
          <SectionIntro
            eyebrow={copy.home.writing.eyebrow}
            index={next()}
            id="writing-title"
            title={copy.home.writing.title}
            link={{ label: 'All writing', href: '/writing/' }}
          />
          <div class="writing">
            {writing.map((entry) => (
              <WritingRow entry={entry} />
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  <!-- Ideas -->
  <Section aria-labelledby="ideas-title" spacing={writing.length > 0 ? 'flush-top' : 'default'}>
    <Container>
      <SectionIntro
        eyebrow={copy.home.ideas.eyebrow}
        index={next()}
        id="ideas-title"
        title={copy.home.ideas.title}
        link={{ label: 'All ideas', href: '/ideas/' }}
      />
      <ul class="ideas">
        {
          ideas.map((idea, i) => (
            <li class="reveal" style={`--stagger: ${i % 2}`}>
              <div class="idea">
                <p class="meta">Idea</p>
                <h3 class="idea__title">{idea.title}</h3>
                <p class="idea__note">{idea.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  <!-- Lab -->
  <Section aria-labelledby="lab-title" spacing="flush-top">
    <Container>
      <SectionIntro
        eyebrow={copy.home.lab.eyebrow}
        index={next()}
        id="lab-title"
        title={copy.home.lab.title}
        lead={copy.home.lab.lead}
        link={{ label: 'Visit the lab', href: '/lab/' }}
      />
      <ul class="cards cards--two">
        {
          lab.map((entry, i) => (
            <li class="reveal" style={`--stagger: ${i}`}>
              <Card href={`/lab/${entry.id}/`}>
                <div class="lab-card">
                  <Badge tone={entry.data.status === 'live' ? 'accent' : 'neutral'} dot>
                    {statusLabel[entry.data.status]}
                  </Badge>
                  <h3 class="lab-card__title">{entry.data.title}</h3>
                  <p class="lab-card__summary">{entry.data.summary}</p>
                  {entry.data.relatedProject && (
                    <p class="meta">Project: {projectTitles.get(entry.data.relatedProject.id)}</p>
                  )}
                </div>
              </Card>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  <!-- Contact -->
  <Section theme="dark" aria-labelledby="contact-title">
    <Container class="reveal">
      <div class="contact glow">
        <Eyebrow index={next()}>{copy.home.contact.eyebrow}</Eyebrow>
        <h2 id="contact-title" class="contact__title">{copy.home.contact.title}</h2>
        {
          site.email && (
            <a class="contact__email" href={`mailto:${site.email}`}>
              {site.email}
            </a>
          )
        }
        {
          site.socials.length > 0 && (
            <ul class="contact__socials">
              {site.socials.map((social) => (
                <li>
                  <a href={social.url} rel="me noopener">
                    <span class="contact__social-label">{social.label}</span>
                    <span class="meta">@{social.handle}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  /* ----- Hero ----- */
  .hero {
    padding-block: clamp(var(--space-12), 8vw, var(--space-24)) clamp(var(--space-16), 8vw, var(--space-24));
  }

  .hero__grid {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  .hero__text {
    display: grid;
    gap: var(--space-5);
    /* The action row adapts to the width of this column, not the viewport:
       on tablets the column is narrow even though the screen is not. */
    container-type: inline-size;
  }

  .hero__name {
    line-height: 0.95;
    letter-spacing: var(--tracking-display);
    /* Slightly larger than the display step: the name is the page's single focal point. */
    font-size: clamp(3.5rem, 2rem + 7vw, 8rem);
    font-weight: var(--weight-bold);
  }

  .hero__role {
    font-size: var(--step-3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .hero__intro {
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  /* Narrow columns: the two main actions share the first row at equal width
     and the quiet third action sits centred beneath them, so nothing wraps
     by accident or hangs indented by its own padding. */
  @container (max-width: 30rem) {
    .hero__actions > :global(*) {
      flex: 1 1 0;
    }

    .hero__actions > :global(:last-child) {
      flex-basis: 100%;
    }
  }

  .hero__portrait {
    width: 100%;
    max-width: 28rem;
  }

  /* Two columns from tablet width up, so the portrait never sits alone
     beside empty space. */
  @media (min-width: 48rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: clamp(var(--space-8), 5vw, var(--space-16));
    }

    .hero__portrait {
      max-width: 30rem;
      justify-self: end;
    }
  }

  /* ----- Disciplines ----- */
  .disciplines {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .disciplines {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .disciplines li:last-child {
      grid-column: 1 / -1;
    }
  }

  /* Five cards on a six-column grid: three across, then two wider ones, so
     the last row is balanced instead of leaving a hole. */
  @media (min-width: 64rem) {
    .disciplines {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .disciplines li {
      grid-column: span 2;
    }

    .disciplines li:nth-child(n + 4),
    .disciplines li:last-child {
      grid-column: span 3;
    }
  }

  .disciplines__title {
    margin-top: clamp(var(--space-4), 3vw, var(--space-8));
    font-size: var(--step-2);
  }

  .disciplines__summary {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }

  /* ----- Shared lists ----- */
  .tracks,
  .writing {
    border-top: 1px solid var(--color-border);
  }

  .cards {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .cards--two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ----- Philosophy quote ----- */
  .quote {
    display: grid;
    justify-items: center;
    gap: var(--space-8);
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
  }

  .quote__text {
    font-size: var(--step-5);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  /* Accent-coloured curly quotes. Not hung outside the block: on centred
     text a hanging mark would pull the first line off-centre. */
  .quote__text p::before {
    content: '\201C';
    color: var(--color-accent);
  }

  .quote__text p::after {
    content: '\201D';
    color: var(--color-accent);
  }

  /* ----- Lab teaser ----- */
  .lab-card {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .lab-card__title {
    margin-top: var(--space-2);
    font-size: var(--step-2);
  }

  .lab-card__summary {
    color: var(--color-text-muted);
  }

  /* ----- Now ----- */
  /* A small, personal section in the warm accent: what is on the desk today. */
  .now {
    display: grid;
    gap: var(--space-6);
    max-width: 48rem;
    padding: clamp(var(--space-6), 4vw, var(--space-10));
    border: 1px solid color-mix(in oklab, var(--color-warm) 30%, var(--color-border));
    border-radius: var(--radius-lg);
    background:
      radial-gradient(ellipse 80% 120% at 0% 0%, color-mix(in oklab, var(--color-warm) 9%, transparent), transparent 70%),
      var(--color-surface-raised);
  }

  .now__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
  }

  .now__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-warm);
  }

  /* A slow "on air" pulse on the dot; still under reduced motion. */
  .now__label::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: var(--radius-pill);
    background-color: currentColor;
  }

  @media (prefers-reduced-motion: no-preference) {
    .now__label::before {
      animation: on-air 2.4s var(--ease-in-out) infinite;
    }
  }

  @keyframes on-air {
    50% {
      opacity: 0.35;
    }
  }

  .now__title {
    font-size: var(--step-2);
  }

  .now__list {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .now__list li {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .now__list li::before {
    content: '';
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 10px;
    height: 1.5px;
    background-color: var(--color-warm);
  }

  .now__list a {
    color: inherit;
    text-decoration-color: color-mix(in oklab, var(--color-warm) 60%, transparent);
  }

  /* ----- Ideas ----- */
  .ideas {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .ideas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .idea {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-6) var(--space-6) var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-raised);
  }

  .idea__title {
    font-size: var(--step-1);
  }

  .idea__note {
    color: var(--color-text-muted);
  }

  /* ----- Contact ----- */
  .contact {
    display: grid;
    gap: var(--space-6);
  }

  .contact__title {
    font-size: var(--step-5);
    letter-spacing: var(--tracking-display);
  }

  .contact__email {
    justify-self: start;
    font-size: var(--step-3);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
    /* Long addresses wrap at any character on narrow phones instead of overflowing. */
    overflow-wrap: anywhere;
    border-bottom: 2px solid color-mix(in oklab, var(--color-accent) 40%, transparent);
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .contact__email:hover {
    border-color: var(--color-accent);
  }

  .contact__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .contact__socials a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 52px;
    padding-inline: var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .contact__socials a:hover {
    background-color: color-mix(in oklab, var(--color-text) 8%, transparent);
  }

  .contact__social-label {
    font-weight: var(--weight-semibold);
  }

</style>
