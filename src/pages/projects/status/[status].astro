---
/**
 * /projects/status/[status]/: the projects index filtered by status. One
 * static page per status, so filtering needs no JavaScript.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectsView from '../../../components/ProjectsView.astro';
import { getPublishedProjects } from '../../../lib/content';
import { statusLabel } from '../../../lib/format';

export function getStaticPaths() {
  return (['active', 'paused', 'shipped', 'concept'] as const).map((status) => ({ params: { status } }));
}

const { status } = Astro.params as { status: 'active' | 'paused' | 'shipped' | 'concept' };
const all = await getPublishedProjects();
---

<BaseLayout
  title={`${statusLabel[status]} projects`}
  description={`${statusLabel[status]} projects by Tesh.`}
  ogKey="projects"
>
  <ProjectsView all={all} status={status} />
</BaseLayout>
