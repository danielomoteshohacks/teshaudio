---
/**
 * Work: every published project as a large artwork panel. Two across on
 * wide screens, stacked on phones.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectPanel from '../../components/ProjectPanel.astro';
import { copy } from '../../lib/site';
import { getPublishedProjects } from '../../lib/content';

const projects = await getPublishedProjects();
---

<BaseLayout title={copy.projects.title} description={copy.projects.description}>
  <div class="wrap">
    <header class="page-head">
      <h1 class="page-head__title enter">{copy.projects.title}</h1>
      <p class="page-head__lead enter" style="--order: 1">{copy.projects.lead}</p>
    </header>
    <ul class="grid">
      {
        projects.map((project) => (
          <li>
            <ProjectPanel project={project} headingLevel="h2" />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page-head {
    display: grid;
    gap: var(--space-4);
    padding-block: clamp(var(--space-12), 7vw, var(--space-24)) clamp(var(--space-10), 5vw, var(--space-16));
  }

  .page-head__title {
    font-size: var(--step-5);
    font-weight: var(--weight-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-hero);
  }

  .page-head__lead {
    font-size: var(--step-1);
    color: var(--color-text-2);
  }

  .grid {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
