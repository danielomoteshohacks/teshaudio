---
/**
 * Project page: a wide artwork header, then status, title and the one-line
 * tagline, a "Read the story" button when an essay is written about the
 * project, the summary as the lead paragraph, any longer write-up from the
 * entry body, the facts (tech, links) and related writing. Anything not set
 * is simply not shown.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Status from '../../components/Status.astro';
import ProjectArt from '../../components/art/ProjectArt.astro';
import { getPublishedProjects, getPublishedWriting, isEmptyBody } from '../../lib/content';
import { formatDate, isoDate, readingTime } from '../../lib/format';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, tagline, summary, note, status, tech, repoUrl, liveUrl } = project.data;
const { Content } = await render(project);
const hasWriteUp = !isEmptyBody(project);
const writing = (await getPublishedWriting()).filter((w) => w.data.relatedProject?.id === project.id);
// The newest essay about the project is its story, linked from the header.
const story = writing.find((w) => w.data.kind === 'essay');
---

<BaseLayout title={title} description={tagline ?? summary}>
  <article>
    <div class="wrap">
      <a class="back slide-link" href="/projects/">&larr; All work</a>
      <div class="art enter">
        <ProjectArt id={project.id} />
      </div>
    </div>

    <div class="wrap wrap--text">
      <header class="head">
        <Status status={status} />
        <h1 class="head__title">{title}</h1>
        {tagline && <p class="head__tagline">{tagline}</p>}
        {
          story && (
            <Button class="head__story" size="lg" href={`/writing/${story.id}/`}>
              Read the story
            </Button>
          )
        }
      </header>

      <div class="prose body">
        <p class="body__summary">{summary}</p>
        {hasWriteUp && <Content />}
        {note && <p class="body__note">{note}</p>}
      </div>

      {
        (tech.length > 0 || repoUrl || liveUrl) && (
          <dl class="facts">
            {tech.length > 0 && (
              <div>
                <dt>Built with</dt>
                <dd>{tech.join(', ')}</dd>
              </div>
            )}
            {(repoUrl || liveUrl) && (
              <div>
                <dt>Links</dt>
                <dd class="facts__links">
                  {repoUrl && (
                    <Button href={repoUrl} variant="secondary" rel="noopener">
                      View on GitHub
                    </Button>
                  )}
                  {liveUrl && (
                    <Button href={liveUrl} variant="secondary" rel="noopener">
                      Try it live
                    </Button>
                  )}
                </dd>
              </div>
            )}
          </dl>
        )
      }

      {
        writing.length > 0 && (
          <section class="related" aria-labelledby="related-title">
            <h2 id="related-title" class="related__title">Writing about {title}</h2>
            <ul class="related__list">
              {writing.map((entry) => (
                <li>
                  <a class="related__link" href={`/writing/${entry.id}/`}>
                    <span class="related__name">{entry.data.title}</span>
                    <span class="label">
                      <time datetime={isoDate(entry.data.pubDate)}>{formatDate(entry.data.pubDate)}</time> · {readingTime(entry.body)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-block: var(--space-8) var(--space-6);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--color-text-2);
  }

  /* The artwork, wide, in a panel one tonal step above the page. */
  .art {
    aspect-ratio: 8 / 5;
    padding: clamp(var(--space-4), 4vw, var(--space-12));
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    background-color: var(--color-bg-2);
  }

  @media (min-width: 48rem) {
    .art {
      aspect-ratio: 2 / 1;
    }
  }

  .head {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding-block: clamp(var(--space-10), 6vw, var(--space-16)) var(--space-8);
  }

  .head__title {
    font-size: var(--step-5);
    font-weight: var(--weight-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-hero);
  }

  .head__tagline {
    font-size: var(--step-2);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-2);
  }

  .head :global(.head__story) {
    margin-top: var(--space-2);
  }

  .body__summary {
    color: var(--color-text);
  }

  .body__note {
    font-size: var(--step-0);
    color: var(--color-text-3);
  }

  .facts {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  .facts div {
    display: grid;
    gap: var(--space-2);
  }

  @media (min-width: 40rem) {
    .facts div {
      grid-template-columns: 9rem 1fr;
      align-items: baseline;
    }
  }

  .facts dt {
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--color-text-3);
  }

  .facts dd {
    margin: 0;
  }

  .facts__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .related {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  .related__title {
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--color-text-3);
    letter-spacing: 0;
  }

  .related__list {
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .related__link {
    display: grid;
    gap: var(--space-1);
    color: var(--color-text);
    text-decoration: none;
  }

  .related__name {
    font-size: var(--step-2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .related__link:hover .related__name {
    color: var(--color-accent);
  }
</style>
