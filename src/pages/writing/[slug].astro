---
/**
 * Article template, shared by every writing kind (essay, research, note,
 * finding).
 *
 * Layout: one comfortable reading column on phones. From 75rem it becomes
 * three columns: table of contents (left), text (centre, about 65ch) and a
 * margin for sidenotes (right), the arrangement used by research-grade
 * typesetting so notes sit beside the line they explain.
 *
 * MDX components available inside articles without importing them:
 * Sidenote, Figure, TrackPlayer, ABPlayer.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import ABPlayer from '../../components/ABPlayer.astro';
import Sidenote from '../../components/mdx/Sidenote.astro';
import Figure from '../../components/mdx/Figure.astro';
import TrackPlayer from '../../components/mdx/TrackPlayer.astro';
import { getProject, getPublishedWriting } from '../../lib/content';
import { formatDate, isoDate, kindLabel, readingTime } from '../../lib/format';
import { site } from '../../lib/site';
import '../../styles/prose.css';
// Emitted as a separate stylesheet and linked only on articles with math,
// so KaTeX's CSS and fonts never load on pages that do not need them.
import katexCss from 'katex/dist/katex.min.css?url';

export async function getStaticPaths() {
  const entries = await getPublishedWriting({ includeUnlisted: true });
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, kind, tags, references, relatedProject, unlisted } =
  entry.data;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const project = relatedProject ? await getProject(relatedProject.id) : undefined;

// A table of contents only earns its space on longer pieces.
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = headings.filter((h) => h.depth === 2).length >= 3;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: site.fullName, alternateName: site.name, url: site.url },
};
---

<BaseLayout title={title} description={description} noindex={unlisted} ogType="article" jsonLd={articleSchema}>
  {remarkPluginFrontmatter.hasMath && <link slot="head" rel="stylesheet" href={katexCss} />}

  <article class="article">
    <Container>
      <header class="article__header">
        <a class="back" href={kind === 'finding' ? '/findings/' : '/writing/'}>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M11 7H3M6.5 3.5L3 7l3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          {kind === 'finding' ? 'All findings' : 'All writing'}
        </a>
        <div class="article__kicker">
          <Badge tone="accent">{kindLabel[kind]}</Badge>
          <p class="meta">
            <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
            {
              updatedDate && (
                <>
                  <span aria-hidden="true"> · </span>Updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
                </>
              )
            }
            <span aria-hidden="true"> · </span>{readingTime(entry.body)}
          </p>
        </div>
        <h1 class="article__title">{title}</h1>
        <p class="article__lead">{description}</p>
        {
          tags.length > 0 && (
            <ul class="article__tags" aria-label="Tags">
              {tags.map((tag) => (
                <li class="meta">#{tag}</li>
              ))}
            </ul>
          )
        }
      </header>

      <div class:list={['article__layout', { 'article__layout--toc': showToc }]}>
        {
          showToc && (
            <nav class="toc" aria-labelledby="toc-title">
              <details class="toc__details" open>
                <summary id="toc-title" class="toc__title meta">Contents</summary>
                <ol class="toc__list">
                  {tocHeadings.map((heading) => (
                    <li class:list={[`toc__item--${heading.depth}`]}>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}
                </ol>
              </details>
            </nav>
          )
        }

        <div class="article__body">
          <div class="prose">
            <Content components={{ Sidenote, Figure, TrackPlayer, ABPlayer }} />
          </div>

          {
            references.length > 0 && (
              <section class="references" aria-labelledby="references-title">
                <h2 id="references-title" class="references__title">References</h2>
                <ol class="references__list">
                  {references.map((ref, i) => (
                    <li id={`ref-${i + 1}`}>
                      {ref.authors && <span>{ref.authors}. </span>}
                      {ref.url ? (
                        <a href={ref.url} rel="noopener">
                          {ref.title}
                        </a>
                      ) : (
                        <cite>{ref.title}</cite>
                      )}
                      {ref.publisher && <span>. {ref.publisher}</span>}
                      {ref.year && <span>, {ref.year}</span>}.
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          <footer class="article__footer">
            {
              project && (
                <p class="article__related">
                  <span class="meta">Related project</span>
                  <a href={`/projects/${project.id}/`}>{project.data.title}</a>
                </p>
              )
            }
            <div class="article__actions">
              <Button variant="secondary" href={kind === 'finding' ? '/findings/' : '/writing/'}>
                {kind === 'finding' ? 'More findings' : 'More writing'}
              </Button>
              <Button variant="ghost" href="/rss.xml">RSS feed</Button>
            </div>
          </footer>
        </div>
      </div>
    </Container>
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: var(--space-10) var(--space-24);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-bottom: clamp(var(--space-8), 5vw, var(--space-16));
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--color-text);
  }

  .article__header {
    display: grid;
    gap: var(--space-5);
    max-width: 52rem;
    margin-bottom: clamp(var(--space-12), 6vw, var(--space-20));
  }

  .article__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .article__title {
    font-size: var(--step-5);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .article__lead {
    max-width: 40rem;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: 0;
    list-style: none;
  }

  /* Sidenotes and figures are numbered per article. */
  .article__body {
    min-width: 0;
    counter-reset: sidenote figure;
  }

  /* ----- Table of contents ----- */
  .toc {
    margin-bottom: var(--space-12);
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .toc__title {
    display: flex;
    align-items: center;
    min-height: 44px;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    cursor: pointer;
  }

  .toc__list {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .toc__list a {
    display: block;
    padding-block: var(--space-2);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .toc__list a:hover {
    color: var(--color-text);
  }

  .toc__item--3 {
    padding-left: var(--space-4);
  }

  /* ----- Wide layout: contents | text | sidenote margin -----
   * Inside the standard container (so every left edge lines up with the
   * header), the text column narrows slightly to 60ch, still well inside the
   * comfortable range, to leave a full-width margin for sidenotes. */
  @media (min-width: 75rem) {
    .article__layout {
      --measure: 60ch;
      display: grid;
      grid-template-columns: 10rem var(--measure) minmax(0, 1fr);
      column-gap: var(--space-8);
    }

    /* The text column stays in the same place with or without contents. */
    .article__body {
      grid-column: 2;
    }

    .toc {
      grid-column: 1;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-height) + var(--space-8));
      align-self: start;
      max-height: calc(100vh - var(--header-height) - var(--space-16));
      overflow-y: auto;
      margin: 0;
      padding: 0;
      border: 0;
    }

    /* Header (which also contains the back link) aligns with the text column. */
    .article__header {
      margin-left: calc(10rem + var(--space-8));
    }
  }

  /* ----- References and footer ----- */
  .references {
    max-width: var(--measure);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .references__title {
    font-size: var(--step-1);
  }

  .references__list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding-left: var(--space-6);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .references__list li::marker {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  /* Target highlight when jumping to a reference from the text. */
  .references__list li:target {
    color: var(--color-text);
  }

  .article__footer {
    display: grid;
    gap: var(--space-8);
    max-width: var(--measure);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .article__related {
    display: grid;
    gap: var(--space-1);
  }

  .article__related a {
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
  }

  .article__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
