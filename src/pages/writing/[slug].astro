---
/**
 * Article template, shared by every writing kind.
 *
 * Set like a publication: a large title, the subtitle, a byline row (small
 * portrait, name, date, reading time), then the body in the reading serif
 * at a 680px measure. Figures break slightly out of the text column on
 * wide screens. From 80rem a quiet contents rail sits to the right of the
 * text; below that there is no contents list, so a phone reader starts
 * reading immediately. It ends with a short author note.
 *
 * MDX components available inside articles without importing them:
 * Sidenote, Figure, PullQuote, ClosingLine. Diagrams are imported by the
 * article that uses them.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Portrait from '../../components/Portrait.astro';
import SerifFont from '../../components/SerifFont.astro';
import Sidenote from '../../components/mdx/Sidenote.astro';
import Figure from '../../components/mdx/Figure.astro';
import PullQuote from '../../components/mdx/PullQuote.astro';
import ClosingLine from '../../components/mdx/ClosingLine.astro';
import { getProject, getPublishedWriting } from '../../lib/content';
import { formatDate, isoDate, kindLabel, readingTime } from '../../lib/format';
import { site } from '../../lib/site';
import '../../styles/prose.css';
// Linked only on articles with math, so KaTeX's CSS and fonts never load
// on pages that do not need them.
import katexCss from 'katex/dist/katex.min.css?url';

export async function getStaticPaths() {
  const entries = await getPublishedWriting({ includeUnlisted: true });
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, kind, references, relatedProject, unlisted } = entry.data;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const project = relatedProject ? await getProject(relatedProject.id) : undefined;

// The contents rail lists the sections (H2s), and only on longer pieces.
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 3;
const github = site.socials.find((s) => s.label === 'GitHub');

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: site.fullName, alternateName: site.name, url: site.url },
};
---

<BaseLayout title={title} description={description} noindex={unlisted} ogType="article" jsonLd={articleSchema}>
  {remarkPluginFrontmatter.hasMath && <link slot="head" rel="stylesheet" href={katexCss} />}
  {/* The serif is the body face; SerifFont preloads it with a metric-matched
      fallback, so the first paragraph does not reflow when it arrives. */}
  <Fragment slot="head"><SerifFont /></Fragment>

  <article class="article">
    <header class="head wrap wrap--text">
      <p class="label enter">{kindLabel[kind]}</p>
      <h1 class="head__title enter" style="--order: 1">{title}</h1>
      <p class="head__subtitle enter" style="--order: 2">{description}</p>
      <div class="byline enter" style="--order: 3">
        <Portrait size="small" />
        <p class="byline__text">
          <span class="byline__name">{site.fullName}</span>
          <span class="label">
            <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
            {
              updatedDate && (
                <>
                  {' '}· Updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
                </>
              )
            }
            {' '}· {readingTime(entry.body)}
          </span>
        </p>
      </div>
    </header>

    <div class:list={['layout', { 'layout--toc': showToc }]}>
      <div class="layout__text">
        <div class="prose prose--read">
          <Content components={{ Sidenote, Figure, PullQuote, ClosingLine }} />
        </div>

        {
          references.length > 0 && (
            <section class="references" aria-labelledby="references-title">
              <h2 id="references-title" class="references__title">References</h2>
              <ol class="references__list">
                {references.map((ref, i) => (
                  <li id={`ref-${i + 1}`}>
                    {ref.authors && <span>{ref.authors}. </span>}
                    {ref.url ? (
                      <a href={ref.url} rel="noopener">
                        {ref.title}
                      </a>
                    ) : (
                      <cite>{ref.title}</cite>
                    )}
                    {ref.publisher && <span>. {ref.publisher}</span>}
                    {ref.year && <span>, {ref.year}</span>}.
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        <footer class="author">
          <Portrait size="small" class="author__portrait" />
          <div class="author__text">
            <p>{site.authorNote}</p>
            <p class="author__links">
              {github && (
                <a class="slide-link" href={github.url} rel="me noopener">
                  {github.label}
                </a>
              )}
              {project && (
                <a class="slide-link" href={`/projects/${project.id}/`}>
                  About {project.data.title}
                </a>
              )}
            </p>
          </div>
        </footer>
      </div>

      {
        showToc && (
          <nav class="toc" aria-labelledby="toc-title">
            <p id="toc-title" class="toc__title">
              On this page
            </p>
            <ol class="toc__list">
              {toc.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding-top: clamp(var(--space-10), 6vw, var(--space-20));
    /* Figures in the body are numbered per article. */
    counter-reset: figure sidenote;
  }

  /* ===== Header ============================================================ */
  .head {
    display: grid;
    gap: var(--space-5);
    margin-bottom: clamp(var(--space-10), 5vw, var(--space-16));
  }

  .head__title {
    font-size: var(--step-5);
    font-weight: var(--weight-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-hero);
  }

  .head__subtitle {
    font-size: var(--step-2);
    font-weight: var(--weight-regular);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-2);
    text-wrap: balance;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .byline__text {
    display: grid;
    line-height: 1.35;
  }

  .byline__name {
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
  }

  /* ===== Body and contents rail ============================================
   * The text column is centred on the page. Figures break out of it up to
   * --width-figure (see the rule below); on a phone the breakout is zero.
   * From 80rem the rail sits in the right-hand margin, far enough out that
   * a breaking-out figure never runs under it.
   */
  .layout {
    width: min(100% - 2 * var(--gutter), var(--width-text));
    margin-inline: auto;
  }

  .layout__text {
    min-width: 0;
  }

  .toc {
    display: none;
  }

  @media (min-width: 80rem) {
    .layout--toc {
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--width-text) minmax(0, 1fr);
      width: 100%;
    }

    .layout--toc .layout__text {
      grid-column: 2;
    }

    .toc {
      display: block;
      grid-column: 3;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-height) + var(--space-12));
      align-self: start;
      max-width: 15rem;
      margin-left: 6rem;
    }
  }

  .toc__title {
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  .toc__list {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-3);
    padding: 0 0 0 var(--space-4);
    border-left: 1px solid var(--color-line);
    list-style: none;
  }

  .toc__list a {
    display: block;
    padding-block: var(--space-1);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--color-text-3);
    text-decoration: none;
  }

  .toc__list a:hover {
    color: var(--color-text);
  }

  /* ===== References and author note ======================================= */
  .references {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  .references__title {
    font-size: var(--step-0);
  }

  .references__list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-left: var(--space-6);
    font-size: var(--step--1);
    color: var(--color-text-2);
  }

  .author {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    margin-top: var(--space-16);
    padding: var(--space-6);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-2);
  }

  .author__text {
    display: grid;
    gap: var(--space-2);
    font-size: var(--step-0);
    line-height: var(--leading-snug);
  }

  .author__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
  }
</style>
