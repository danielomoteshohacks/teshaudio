---
/**
 * Article template, shared by every writing kind (essay, research, note,
 * finding).
 *
 * Layout: one comfortable reading column on phones. From 75rem it becomes
 * three columns: table of contents (left), text (centre, about 65ch) and a
 * margin for sidenotes (right), the arrangement used by research-grade
 * typesetting so notes sit beside the line they explain.
 *
 * MDX components available inside articles without importing them:
 * Sidenote, Figure, TrackPlayer, ABPlayer, PullQuote, Photo. Diagrams are
 * imported by the article that uses them.
 *
 * Reading furniture: a progress bar (CSS scroll-driven, no JavaScript), the
 * reading time, a byline, an optional cover, and a contents list from the
 * H2s, sticky beside the text on desktop and a collapsed disclosure on
 * phones. Body text is set in a reading serif (Source Serif 4), loaded only
 * on article pages so no other page pays for it.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import ABPlayer from '../../components/ABPlayer.astro';
import Sidenote from '../../components/mdx/Sidenote.astro';
import Figure from '../../components/mdx/Figure.astro';
import TrackPlayer from '../../components/mdx/TrackPlayer.astro';
import PullQuote from '../../components/mdx/PullQuote.astro';
import Photo from '../../components/mdx/Photo.astro';
import CoverArt from '../../components/CoverArt.astro';
import { Image } from 'astro:assets';
import { getPhoto } from '../../lib/photos';
import '@fontsource-variable/source-serif-4/opsz.css';
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
import { getProject, getPublishedWriting } from '../../lib/content';
import { formatDate, isoDate, kindLabel, readingTime } from '../../lib/format';
import { site } from '../../lib/site';
import '../../styles/prose.css';
// Emitted as a separate stylesheet and linked only on articles with math,
// so KaTeX's CSS and fonts never load on pages that do not need them.
import katexCss from 'katex/dist/katex.min.css?url';

export async function getStaticPaths() {
  const entries = await getPublishedWriting({ includeUnlisted: true });
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, kind, tags, references, relatedProject, unlisted, cover } =
  entry.data;
// The cover photo if its file has been added; otherwise the site's own cover
// art stands in (see CoverArt.astro), so a missing photo never breaks a page.
const coverImage = cover ? getPhoto(cover.file) : undefined;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const project = relatedProject ? await getProject(relatedProject.id) : undefined;

// A table of contents only earns its space on longer pieces. H2s only: the
// sections are the shape of the argument; H3s would turn it into an index.
const tocHeadings = headings.filter((h) => h.depth === 2);
const showToc = tocHeadings.length >= 3;
// Findings are not in the navigation while that page is quiet, so every
// article leads back to Writing, which lists all kinds.
const backHref = '/writing/';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: site.fullName, alternateName: site.name, url: site.url },
};
---

<BaseLayout title={title} description={description} noindex={unlisted} ogType="article" jsonLd={articleSchema}>
  {remarkPluginFrontmatter.hasMath && <link slot="head" rel="stylesheet" href={katexCss} />}
  {/* The serif is the article's body face: fetch it alongside the CSS rather
      than after, so the first paragraph does not reflow when it arrives. */}
  <link slot="head" rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />

  {/* Reading progress: a hairline across the top that fills as you scroll.
      Purely decorative, so hidden from assistive tech. */}
  <div class="progress" aria-hidden="true"></div>

  <article class="article">
    <Container>
      <header class="article__header">
        <a class="back" href={backHref}>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M11 7H3M6.5 3.5L3 7l3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          All writing
        </a>
        <div class="article__kicker">
          <Badge tone="accent">{kindLabel[kind]}</Badge>
          <p class="meta">
            <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
            {
              updatedDate && (
                <>
                  <span aria-hidden="true"> · </span>Updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
                </>
              )
            }
            <span aria-hidden="true"> · </span>{readingTime(entry.body)}
          </p>
        </div>
        <h1 class="article__title">{title}</h1>
        <p class="article__lead">{description}</p>
        <p class="article__byline">By {site.firstName} ({site.name})</p>
        {
          tags.length > 0 && (
            <ul class="article__tags" aria-label="Tags">
              {tags.map((tag) => (
                <li class="meta">#{tag}</li>
              ))}
            </ul>
          )
        }
      </header>

      {
        cover && (
          <figure class="cover">
            <div class="cover__media">
              {coverImage ? (
                <Image
                  src={coverImage}
                  alt={cover.alt}
                  widths={[640, 960, 1280, 1600, 2000]}
                  sizes="(min-width: 75rem) 72rem, 100vw"
                  quality={76}
                  loading="eager"
                  fetchpriority="high"
                />
              ) : (
                <>
                  <CoverArt id="article-cover" />
                  {/* Marks the slot while the cover photo is on its way;
                      decorative, so hidden from screen readers. */}
                  <span class="cover__slot-label" aria-hidden="true">Photo coming soon</span>
                </>
              )}
            </div>
            {coverImage && cover.credit && (
              <figcaption class="cover__credit">
                Photo:{' '}
                {cover.creditUrl ? (
                  <a href={cover.creditUrl} rel="noopener">
                    {cover.credit}
                  </a>
                ) : (
                  cover.credit
                )}
              </figcaption>
            )}
          </figure>
        )
      }

      <div class:list={['article__layout', { 'article__layout--toc': showToc }]}>
        {
          showToc && (
            <>
              {/* Two renderings of one list, swapped by CSS (display: none
                  removes the hidden one from the accessibility tree too):
                  a collapsed disclosure on phones, so the essay starts
                  immediately, and an always-open sticky list on desktop.
                  This avoids any script to open or close it by screen size. */}
              <nav class="toc toc--compact" aria-label="Contents">
                <details class="toc__details">
                  <summary class="toc__title meta">
                    Contents
                    <span class="toc__count">{tocHeadings.length} sections</span>
                  </summary>
                  <ol class="toc__list">
                    {tocHeadings.map((heading) => (
                      <li>
                        <a href={`#${heading.slug}`}>{heading.text}</a>
                      </li>
                    ))}
                  </ol>
                </details>
              </nav>
              <nav class="toc toc--rail" aria-labelledby="toc-title">
                <p id="toc-title" class="toc__title meta">Contents</p>
                <ol class="toc__list">
                  {tocHeadings.map((heading) => (
                    <li>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            </>
          )
        }

        <div class="article__body">
          <div class:list={['prose', 'prose--reading', { 'prose--dropcap': kind === 'essay' }]}>
            <Content components={{ Sidenote, Figure, TrackPlayer, ABPlayer, PullQuote, Photo }} />
          </div>

          {
            references.length > 0 && (
              <section class="references" aria-labelledby="references-title">
                <h2 id="references-title" class="references__title">References</h2>
                <ol class="references__list">
                  {references.map((ref, i) => (
                    <li id={`ref-${i + 1}`}>
                      {ref.authors && <span>{ref.authors}. </span>}
                      {ref.url ? (
                        <a href={ref.url} rel="noopener">
                          {ref.title}
                        </a>
                      ) : (
                        <cite>{ref.title}</cite>
                      )}
                      {ref.publisher && <span>. {ref.publisher}</span>}
                      {ref.year && <span>, {ref.year}</span>}.
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          <footer class="article__footer">
            {
              project && (
                <p class="article__related">
                  <span class="meta">Related project</span>
                  <a href={`/projects/${project.id}/`}>{project.data.title}</a>
                </p>
              )
            }
            <div class="article__actions">
              <Button variant="secondary" href={backHref}>
                More writing
              </Button>
              <Button variant="ghost" href="/rss.xml">RSS feed</Button>
            </div>
          </footer>
        </div>
      </div>
    </Container>
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: var(--space-10) var(--space-24);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-bottom: clamp(var(--space-8), 5vw, var(--space-16));
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--color-text);
  }

  .article__header {
    display: grid;
    gap: var(--space-5);
    max-width: 52rem;
    margin-bottom: clamp(var(--space-12), 6vw, var(--space-20));
  }

  .article__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .article__title {
    font-size: var(--step-5);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .article__lead {
    max-width: 40rem;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: 0;
    list-style: none;
  }

  /* Sidenotes and figures are numbered per article. */
  .article__body {
    min-width: 0;
    counter-reset: sidenote figure;
  }

  /* ----- Byline and cover ----- */
  .article__byline {
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .cover {
    margin-bottom: clamp(var(--space-12), 6vw, var(--space-20));
  }

  .cover__media {
    overflow: hidden;
    /* Cinematic on wide screens, taller on phones so the subject still
       fills the frame. */
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-xl);
    background-color: var(--neutral-950);
    box-shadow: var(--shadow-2);
  }

  @media (min-width: 48rem) {
    .cover__media {
      aspect-ratio: 21 / 9;
    }
  }

  .cover__media {
    position: relative;
  }

  /* Same pill as the in-article photo slots (Photo.astro): light on the
     always-dark cover art. */
  .cover__slot-label {
    position: absolute;
    left: var(--space-5);
    bottom: var(--space-5);
    padding: var(--space-1) var(--space-3);
    border: 1px solid color-mix(in srgb, var(--neutral-text-dark) 22%, transparent);
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--neutral-950) 45%, transparent);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--neutral-text-dark);
  }

  .cover__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover__credit {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-text-muted);
  }

  .cover__credit a {
    color: inherit;
  }

  /* ----- Reading progress -----
   * A scroll-driven animation on the root scroller: the bar's scale follows
   * the scroll position with no JavaScript. Browsers without scroll timelines
   * simply never show it. transform only, so it never triggers layout. */
  .progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      display: block;
      position: fixed;
      inset: 0 0 auto;
      z-index: 60;
      height: 3px;
      background: linear-gradient(90deg, var(--color-accent), var(--color-warm));
      transform-origin: 0 50%;
      transform: scaleX(0);
      pointer-events: none;
      animation: progress linear both;
      animation-timeline: scroll(root block);
    }
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  /* ----- Table of contents ----- */
  .toc__list {
    display: grid;
    gap: var(--space-1);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
  }

  .toc__list li {
    counter-increment: toc;
  }

  .toc__list a {
    display: grid;
    grid-template-columns: 2rem 1fr;
    padding-block: var(--space-2);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  /* Section numbers in mono, like the site's section indices. */
  .toc__list a::before {
    content: counter(toc, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    line-height: 1.9;
    color: var(--color-text-muted);
    opacity: 0.8;
  }

  .toc__list a:hover {
    color: var(--color-text);
  }

  .toc__title {
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  /* Phones and tablets: a collapsed disclosure above the text. */
  .toc--compact {
    margin-bottom: var(--space-10);
    border-block: 1px solid var(--color-border);
  }

  .toc--compact .toc__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 52px;
    cursor: pointer;
    list-style: none;
  }

  .toc--compact .toc__title::-webkit-details-marker {
    display: none;
  }

  /* A plus that turns into a minus when open. */
  .toc--compact .toc__title::after {
    content: '+';
    font-size: var(--step-1);
    line-height: 1;
    color: var(--color-text);
  }

  .toc--compact details[open] .toc__title::after {
    content: '\2212';
  }

  .toc__count {
    margin-left: auto;
    text-transform: none;
    letter-spacing: 0;
  }

  .toc--compact .toc__list {
    padding-bottom: var(--space-4);
  }

  .toc--rail {
    display: none;
  }

  /* ----- Wide layout: contents rail | reading column -----
   * Inside the standard container (so every left edge lines up with the
   * header). The rail is sticky and scrolls on its own if a piece has many
   * sections. */
  @media (min-width: 75rem) {
    .article__layout--toc {
      display: grid;
      grid-template-columns: 13rem minmax(0, var(--measure-reading));
      column-gap: clamp(var(--space-12), 5vw, var(--space-20));
    }

    .toc--compact {
      display: none;
    }

    .toc--rail {
      display: block;
      position: sticky;
      top: calc(var(--header-height) + var(--space-10));
      align-self: start;
      max-height: calc(100vh - var(--header-height) - var(--space-16));
      overflow-y: auto;
    }

    /* Header aligns with the reading column when there is a rail. */
    .article:has(.article__layout--toc) .article__header {
      margin-left: calc(13rem + clamp(var(--space-12), 5vw, var(--space-20)));
    }
  }

  /* ----- References and footer ----- */
  .references {
    max-width: var(--measure-reading);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .references__title {
    font-size: var(--step-1);
  }

  .references__list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding-left: var(--space-6);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .references__list li::marker {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  /* Target highlight when jumping to a reference from the text. */
  .references__list li:target {
    color: var(--color-text);
  }

  .article__footer {
    display: grid;
    gap: var(--space-8);
    max-width: var(--measure-reading);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .article__related {
    display: grid;
    gap: var(--space-1);
  }

  .article__related a {
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
  }

  .article__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
