---
/**
 * Writing: every published piece, newest first, as editorial rows. Date and
 * reading time on the left, title and subtitle on the right (wide screens).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy } from '../../lib/site';
import { getPublishedWriting } from '../../lib/content';
import { formatDate, isoDate, kindLabel, readingTime } from '../../lib/format';

const entries = await getPublishedWriting();
---

<BaseLayout title={copy.writing.title} description={copy.writing.description}>
  <div class="wrap">
    <header class="page-head">
      <h1 class="page-head__title enter">{copy.writing.title}</h1>
      <p class="page-head__lead enter" style="--order: 1">{copy.writing.lead}</p>
    </header>
    <ol class="list">
      {
        entries.map((entry) => (
          <li>
            <a class="row" href={`/writing/${entry.id}/`}>
              <p class="row__meta label">
                <time datetime={isoDate(entry.data.pubDate)}>{formatDate(entry.data.pubDate)}</time>
                <span>
                  {kindLabel[entry.data.kind]} · {readingTime(entry.body)}
                </span>
              </p>
              <div class="row__text">
                <h2 class="row__title">{entry.data.title}</h2>
                <p class="row__subtitle">{entry.data.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>

<style>
  .page-head {
    display: grid;
    gap: var(--space-4);
    padding-block: clamp(var(--space-12), 7vw, var(--space-24)) clamp(var(--space-10), 5vw, var(--space-16));
  }

  .page-head__title {
    font-size: var(--step-5);
    font-weight: var(--weight-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-hero);
  }

  .page-head__lead {
    font-size: var(--step-1);
    color: var(--color-text-2);
  }

  .list {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .list li {
    border-bottom: 1px solid var(--color-line);
  }

  .row {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-8);
    color: var(--color-text);
    text-decoration: none;
  }

  .row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }

  .row__text {
    display: grid;
    gap: var(--space-3);
  }

  .row__title {
    font-size: var(--step-3);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-display);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .row:hover .row__title {
    color: var(--color-accent);
  }

  .row__subtitle {
    max-width: 40rem;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-text-2);
  }

  @media (min-width: 56rem) {
    .row {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-10);
      padding-block: var(--space-10);
    }

    .row__meta {
      flex-direction: column;
      padding-top: 0.6em;
    }
  }
</style>
