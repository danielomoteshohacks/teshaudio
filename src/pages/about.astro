---
/**
 * About: portrait and bio, what Tesh does, what Tesh believes about sound,
 * and education. Every word comes from src/data/about.ts, src/lib/beliefs.ts
 * and site.ts; this page only lays it out.
 *
 * The beliefs are the emotional centre of the site, so they are set like a
 * page in a fine book: one belief per row between hairline rules, never
 * cards; the headline in the serif at display size, the text in the serif at
 * reading size; generous space. Each row rises into view once as it
 * arrives, like everything else on the site; nothing else moves. The page
 * ends with the short "Work with me" invitation.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Portrait from '../components/Portrait.astro';
import Waveform from '../components/Waveform.astro';
import SerifFont from '../components/SerifFont.astro';
import DecibelArt from '../components/art/DecibelArt.astro';
import WorkWithMe from '../components/WorkWithMe.astro';
import { about } from '../data/about';
import { beliefId, beliefs } from '../lib/beliefs';
import { copy, site } from '../lib/site';
import { personSchema } from '../lib/schema';
---

<BaseLayout title="About" description={copy.about.description} jsonLd={personSchema()}>
  <Fragment slot="head"><SerifFont priority="low" /></Fragment>

  <section class="intro wrap" aria-labelledby="about-title">
    <div class="intro__portrait enter">
      <Portrait
        priority
        sizes="(min-width: 75rem) 28rem, (min-width: 48rem) 38vw, (max-height: 32rem) 50vh, min(calc(100vw - 2.5rem), 26rem)"
      />
    </div>
    <div class="intro__text">
      <h1 id="about-title" class="intro__title enter" style="--order: 1">{site.fullName}, known as {site.name}</h1>
      <div class="intro__bio enter" style="--order: 2">
        {about.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="block wrap" aria-labelledby="do-title" data-reveal>
    <h2 id="do-title" class="block__title">{copy.about.doTitle}</h2>
    <ul class="skills">
      {
        about.skills.map((skill) => (
          <li class="skills__item">
            <h3 class="skills__title">{skill.title}</h3>
            <p class="skills__note">{skill.note}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="beliefs" class="beliefs wrap" aria-labelledby="believe-title">
    <header class="beliefs__opener" data-reveal>
      <h2 id="believe-title" class="beliefs__label">{copy.about.believeTitle}</h2>
      <div class="beliefs__wave"><Waveform seed={5} /></div>
    </header>
    {/* role="list" keeps the list announced as a list in Safari, which drops
        list semantics when list-style is none. */}
    <ol class="beliefs__list" role="list">
      {
        beliefs.map((belief) => (
          <li id={beliefId(belief.id)} class:list={['belief', { 'belief--feature': belief.id === 'ears' }]} data-reveal>
            <p class="belief__number" aria-hidden="true">{belief.number}</p>
            <h3 class="belief__headline">{belief.headline}</h3>
            <p class="belief__body">{belief.body}</p>
            {
              belief.id === 'ears' && (
                <div class="belief__echo">
                  <DecibelArt quiet />
                </div>
              )
            }
          </li>
        ))
      }
    </ol>
  </section>

  <section class="block wrap" aria-labelledby="education-title" data-reveal>
    <h2 id="education-title" class="block__title">{copy.about.educationTitle}</h2>
    <p class="education">{about.education}</p>
  </section>

  <div class="invite wrap">
    <WorkWithMe variant="short" />
  </div>
</BaseLayout>

<style>
  /* ===== Intro: portrait beside the name and bio ========================== */
  .intro {
    display: grid;
    gap: var(--space-10);
    padding-top: clamp(var(--space-10), 6vw, var(--space-24));
  }

  .intro__portrait {
    width: 100%;
    max-width: 26rem;
  }

  .intro__text {
    display: grid;
    align-content: center;
    gap: var(--space-8);
  }

  .intro__title {
    font-size: var(--step-5);
    font-weight: var(--weight-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-hero);
  }

  .intro__bio {
    display: grid;
    gap: var(--space-5);
    max-width: 36rem;
    font-size: var(--step-1);
    line-height: var(--leading-body);
    color: var(--color-text-2);
  }

  /* The first paragraph introduces Tesh: it carries the full ink. */
  .intro__bio p:first-child {
    color: var(--color-text);
  }

  /* Phones: the name, then the portrait, then the bio. Tablets (640 to
     1023px): the name across the full width, then the portrait beside the
     bio, so the title never squeezes into a narrow column. Desktop: the
     portrait on the left, the name and bio on the right. Phones in
     landscape hold the portrait to about half the screen height. */
  .intro__text {
    display: contents;
  }

  .intro {
    grid-template-areas: 'title' 'portrait' 'bio';
    gap: var(--space-8);
  }

  .intro__title { grid-area: title; }
  .intro__portrait { grid-area: portrait; }
  .intro__bio { grid-area: bio; }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .intro {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-areas:
        'title title'
        'portrait bio';
      align-items: center;
      column-gap: clamp(var(--space-8), 5vw, var(--space-12));
    }

    .intro__portrait {
      max-width: none;
    }
  }

  @media (max-width: 63.99rem) and (max-height: 32rem) and (orientation: landscape) {
    .intro {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'title title'
        'portrait bio';
      align-items: start;
    }

    .intro__portrait {
      width: calc(55svh * 0.8);
    }
  }

  @media (min-width: 64rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      grid-template-areas: 'portrait text';
      align-items: center;
      gap: clamp(var(--space-10), 6vw, var(--space-24));
    }

    .intro__text {
      grid-area: text;
      display: grid;
      align-content: center;
      gap: var(--space-8);
    }

    .intro__text > * {
      grid-area: auto;
    }

    .intro__portrait {
      max-width: 32rem;
    }
  }

  /* ===== Sections =========================================================
   * Each block: a heading column on the left, content on the right (wide
   * screens), with a hairline above, the editorial rhythm of a printed CV.
   */
  .block {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--section-gap);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  .block__title {
    font-size: var(--step-3);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
  }

  @media (min-width: 64rem) {
    .block {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-16);
    }
  }

  /* ----- What I do: two columns of title and note ----- */
  .skills {
    display: grid;
    gap: 0 var(--space-10);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .skills__item {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-line);
  }

  .skills__title {
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }

  .skills__note {
    color: var(--color-text-2);
  }

  /* ===== What I believe about sound ======================================
   * The opener: a small uppercase label over a short static waveform, the
   * site's signature. Then seven rows between 1px hairlines: no cards, no
   * boxes. Phones stack number, headline, text. From 1024px the number and
   * headline sit in the left columns and the text in the right, all on one
   * baseline, like a page in a book.
   */
  .beliefs {
    margin-top: var(--section-gap);
  }

  .beliefs__opener {
    display: grid;
    gap: var(--space-5);
    margin-bottom: clamp(var(--space-12), 6vw, var(--space-20));
  }

  .beliefs__label {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-2);
  }

  .beliefs__wave {
    max-width: 18rem;
  }

  .beliefs__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .belief {
    display: grid;
    gap: var(--space-3);
    /* At least 56px between rows on phones: 64px of padding each side of
       the rule. */
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--color-line);
    /* Links from Home land on the row. The page's scroll-padding already
       clears the sticky header; this adds a little air above the hairline. */
    scroll-margin-top: var(--space-4);
  }

  /* Small tabular figures in the accent: 01 to 07 line up in any font. */
  .belief__number {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }

  .belief__headline {
    max-width: 16em;
    font-family: var(--font-serif);
    font-size: var(--step-belief);
    font-weight: 500;
    font-optical-sizing: auto;
    line-height: 1.08;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--color-text);
  }

  .belief__body {
    max-width: 34em;
    margin-top: var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--step-belief-body);
    line-height: 1.65;
    color: var(--color-text-2);
    text-wrap: pretty;
  }

  /* The faint cochlea beside the belief about the ear: desktop only, and
     nowhere else. The line colour at low opacity, so it is felt more than
     seen. */
  .belief__echo {
    display: none;
  }

  /* From 834px (tablets in portrait and up): two columns. The left holds
     the number and, under it, the headline; the right holds the text, its
     first line on the headline's first baseline, like a page in a book. */
  @media (min-width: 52.125rem) {
    .belief {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-areas:
        'number .'
        'headline body';
      column-gap: clamp(var(--space-10), 6vw, var(--space-24));
      row-gap: var(--space-4);
      align-items: first baseline;
      padding-block: clamp(var(--space-16), 7vw, var(--space-24));
    }

    .belief__number {
      grid-area: number;
    }

    .belief__headline {
      grid-area: headline;
    }

    .belief__body {
      grid-area: body;
      margin-top: 0;
    }

    /* The emphasised row: a step more size and a little more measure for
       the headline, and room beneath it for the echo. The columns stay
       where they are, so the text column keeps one edge down the page. */
    .belief--feature {
      grid-template-areas:
        'number .'
        'headline body'
        'echo body';
    }

    .belief--feature .belief__headline {
      max-width: none;
      font-size: calc(var(--step-belief) * 1.12);
      letter-spacing: -0.02em;
    }
  }

  @media (min-width: 64rem) {
    .belief--feature .belief__echo {
      grid-area: echo;
      align-self: start;
      display: block;
      width: min(100%, 15rem);
      /* Pulled left by the drawing's own padding, so the spiral's outer edge
         lines up with the headline above it. */
      margin: var(--space-10) 0 0 -1.2rem;
      opacity: 0.35;
    }
  }

  /* ----- Education ----- */
  .education {
    font-size: var(--step-1);
  }

  .invite {
    margin-top: var(--section-gap);
  }
</style>
