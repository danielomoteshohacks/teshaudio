---
/**
 * About: portrait and bio, what Tesh does, what Tesh believes about sound
 * (the four philosophy entries, rendered here as one readable section), and
 * education. Every word comes from src/data/about.ts, site.ts and the
 * philosophy collection; this page only lays it out.
 */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Portrait from '../components/Portrait.astro';
import { about } from '../data/about';
import { copy, site } from '../lib/site';
import { personSchema } from '../lib/schema';
import { getPhilosophySections } from '../lib/content';
import '../styles/prose.css';

const beliefs = await Promise.all(
  (await getPhilosophySections()).map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout title="About" description={copy.about.description} jsonLd={personSchema()}>
  <section class="intro wrap" aria-labelledby="about-title">
    <div class="intro__portrait enter">
      <Portrait priority sizes="(min-width: 64rem) 32rem, (min-width: 48rem) 40vw, calc(100vw - 2.5rem)" />
    </div>
    <div class="intro__text">
      <h1 id="about-title" class="intro__title enter" style="--order: 1">{site.fullName}, known as {site.name}</h1>
      <div class="intro__bio enter" style="--order: 2">
        {about.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="block wrap" aria-labelledby="do-title">
    <h2 id="do-title" class="block__title">{copy.about.doTitle}</h2>
    <ul class="skills">
      {
        about.skills.map((skill) => (
          <li class="skills__item">
            <h3 class="skills__title">{skill.title}</h3>
            <p class="skills__note">{skill.note}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    beliefs.length > 0 && (
      <section id="beliefs" class="block wrap" aria-labelledby="believe-title">
        <h2 id="believe-title" class="block__title">{copy.about.believeTitle}</h2>
        <ol class="beliefs">
          {beliefs.map(({ entry, Content }, i) => (
            <li class="belief">
              <p class="belief__index">{String(i + 1).padStart(2, '0')}</p>
              <div class="belief__body">
                <h3 class="belief__title">{entry.data.title}</h3>
                {entry.data.thesis && <p class="belief__thesis">{entry.data.thesis}</p>}
                <div class="prose belief__text">
                  <Content />
                </div>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="block wrap" aria-labelledby="education-title">
    <h2 id="education-title" class="block__title">{copy.about.educationTitle}</h2>
    <p class="education">{about.education}</p>
  </section>
</BaseLayout>

<style>
  /* ===== Intro: portrait beside the name and bio ========================== */
  .intro {
    display: grid;
    gap: var(--space-10);
    padding-top: clamp(var(--space-10), 6vw, var(--space-24));
  }

  .intro__portrait {
    width: 100%;
    max-width: 26rem;
  }

  .intro__text {
    display: grid;
    align-content: center;
    gap: var(--space-8);
  }

  .intro__title {
    font-size: var(--step-5);
    font-weight: var(--weight-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-hero);
  }

  .intro__bio {
    display: grid;
    gap: var(--space-5);
    max-width: 36rem;
    font-size: var(--step-1);
    line-height: var(--leading-body);
    color: var(--color-text-2);
  }

  /* The first paragraph introduces Tesh: it carries the full ink. */
  .intro__bio p:first-child {
    color: var(--color-text);
  }

  @media (max-width: 47.99rem) {
    /* Phones: the name first, then the portrait, then the bio. */
    .intro__text {
      display: contents;
    }

    .intro__title { order: 1; }
    .intro__portrait { order: 2; }
    .intro__bio { order: 3; }

    .intro {
      gap: var(--space-8);
    }
  }

  @media (min-width: 48rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      align-items: center;
      gap: clamp(var(--space-10), 6vw, var(--space-24));
    }

    .intro__portrait {
      max-width: 32rem;
    }
  }

  /* ===== Sections =========================================================
   * Each block: a heading column on the left, content on the right (wide
   * screens), with a hairline above, the editorial rhythm of a printed CV.
   */
  .block {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--section-gap);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  .block__title {
    font-size: var(--step-3);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
  }

  @media (min-width: 64rem) {
    .block {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-16);
    }
  }

  /* ----- What I do: two columns of title and note ----- */
  .skills {
    display: grid;
    gap: 0 var(--space-10);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .skills__item {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-line);
  }

  .skills__title {
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }

  .skills__note {
    color: var(--color-text-2);
  }

  /* ----- What I believe: numbered, the thesis set large ----- */
  .beliefs {
    display: grid;
    gap: var(--space-12);
    padding: 0;
    list-style: none;
  }

  .belief {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-4);
  }

  .belief + .belief {
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-line);
  }

  .belief__index {
    padding-top: 0.2em;
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }

  .belief__body {
    display: grid;
    gap: var(--space-3);
  }

  .belief__title {
    font-size: var(--step-0);
    font-weight: var(--weight-medium);
    color: var(--color-text-3);
    letter-spacing: 0;
  }

  .belief__thesis {
    font-size: var(--step-3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .belief__text {
    max-width: 38rem;
    margin-top: var(--space-2);
  }

  /* ----- Education ----- */
  .education {
    font-size: var(--step-1);
  }
</style>
