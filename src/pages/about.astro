---
/**
 * About: portrait, bio, education and the areas Tesh works in.
 * Every word comes from src/data/about.ts (and site.ts); this page only lays
 * it out. Strictly audio: no unrelated credentials or history.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Portrait from '../components/Portrait.astro';
import SectionIntro from '../components/SectionIntro.astro';
import { about } from '../data/about';
import { copy, site } from '../lib/site';
import { personSchema } from '../lib/schema';
---

<BaseLayout
  title="About"
  description={`About ${site.fullName}, known as ${site.name}: music producer, composer, mix and mastering engineer and spatial audio software engineer in ${site.location}.`}
  jsonLd={personSchema()}
>
  <section class="about-hero" aria-labelledby="about-title">
    <Container>
      <div class="about-hero__grid">
        <div class="about-hero__head glow">
          <Eyebrow>About</Eyebrow>
          <h1 id="about-title" class="about-hero__title">{site.fullName}, known as {site.name}</h1>
          <p class="meta about-hero__roles">{site.disciplines.map((d) => d.title).join(' · ')}</p>
        </div>
        <div class="about-hero__portrait">
          <Portrait priority sizes="(min-width: 64rem) 34rem, calc(100vw - 2rem)" />
        </div>
        <div class="about-hero__text">
          <div class="about-hero__bio">
            {about.bio.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <p class="about-hero__education">
            <span class="meta">Education</span>
            {about.education}
          </p>
        </div>
      </div>
    </Container>
  </section>

  <Section theme="dark" aria-labelledby="skills-title">
    <Container>
      <SectionIntro eyebrow="Practice" index="01" id="skills-title" title={copy.about.skillsTitle} />
      <ul class="skills">
        {
          about.skills.map((skill, i) => (
            <li class="skills__item reveal" style={`--stagger: ${i % 3}`}>
              <h3 class="skills__title">{skill.title}</h3>
              <p class="skills__note">{skill.note}</p>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>
</BaseLayout>

<style>
  .about-hero {
    padding-block: clamp(var(--space-12), 8vw, var(--space-24));
  }

  /* Phones: name first, then the portrait, then the bio, so the page opens
     with context rather than an image. Wide screens: portrait on the left
     spanning both rows. */
  .about-hero__grid {
    display: grid;
    grid-template-areas: 'head' 'portrait' 'text';
    gap: var(--space-10);
    align-items: start;
  }

  .about-hero__head {
    grid-area: head;
    display: grid;
    gap: var(--space-5);
  }

  .about-hero__portrait {
    grid-area: portrait;
    max-width: 28rem;
  }

  .about-hero__text {
    grid-area: text;
    display: grid;
    gap: var(--space-8);
  }

  .about-hero__title {
    font-size: var(--step-5);
  }

  .about-hero__roles {
    line-height: var(--leading-body);
  }

  .about-hero__bio {
    display: grid;
    gap: var(--space-5);
    max-width: var(--measure);
  }

  /* The opening paragraph reads as a lead; the rest at body size. */
  .about-hero__bio p:first-child {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .about-hero__education {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    max-width: var(--measure);
  }

  .about-hero__education .meta {
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  @media (min-width: 64rem) {
    .about-hero__grid {
      grid-template-areas: 'portrait head' 'portrait text';
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-rows: auto 1fr;
      gap: var(--space-8) var(--space-20);
    }

    /* Kept in view while the bio scrolls past it. */
    .about-hero__portrait {
      position: sticky;
      top: calc(var(--header-height) + var(--space-8));
      max-width: none;
    }

    .about-hero__head {
      padding-top: var(--space-8);
    }
  }

  /* ----- Practice ----- */
  .skills {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .skills {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .skills__item {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-6) var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-raised);
  }

  .skills__title {
    font-size: var(--step-1);
  }

  .skills__note {
    color: var(--color-text-muted);
  }
</style>
