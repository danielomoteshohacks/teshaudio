---
/**
 * 404: shown by Cloudflare Pages for any path that does not exist.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex ogKey="home">
  <section class="not-found" aria-labelledby="not-found-title">
    <Container>
      <p class="not-found__code" aria-hidden="true">404</p>
      <h1 id="not-found-title" class="not-found__title">This page is silent.</h1>
      <p class="not-found__body">The link may be old, or the page may have moved.</p>
      <div class="not-found__actions">
        <Button href="/">Go home</Button>
        <Button href="/music/" variant="secondary">Listen instead</Button>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    align-items: center;
    min-height: calc(100vh - var(--header-height));
    min-height: calc(100svh - var(--header-height));
    padding-block: var(--space-16);
  }

  /* Outlined numerals: present but quiet, so the sentence below leads. */
  .not-found__code {
    font-size: clamp(6rem, 3rem + 18vw, 16rem);
    font-weight: var(--weight-bold);
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
    font-variant-numeric: tabular-nums;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-border-strong);
  }

  .not-found__title {
    margin-top: var(--space-8);
    font-size: var(--step-4);
  }

  .not-found__body {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    color: var(--color-text-muted);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
</style>
