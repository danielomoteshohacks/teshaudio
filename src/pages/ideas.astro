---
/**
 * Ideas: things Tesh wants to build or understand next. Notes, not
 * projects, so no status or dates. Data lives in src/data/ideas.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import PageHeader from '../components/PageHeader.astro';
import { ideas } from '../data/ideas';
import { copy } from '../lib/site';
---

<BaseLayout title="Ideas" description={copy.ideas.description}>
  <PageHeader eyebrow="Ideas" title={copy.ideas.title} lead={copy.ideas.lead} />

  <Section spacing="flush-top" aria-label="Ideas">
    <Container>
      <ul class="ideas">
        {
          ideas.map((idea, i) => (
            <li class="idea reveal" style={`--stagger: ${i % 2}`}>
              <p class="meta">Idea</p>
              <h2 class="idea__title">{idea.title}</h2>
              <p class="idea__note">{idea.note}</p>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>
</BaseLayout>

<style>
  .ideas {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .ideas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .idea {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-6) var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-raised);
  }

  .idea__title {
    font-size: var(--step-2);
  }

  .idea__note {
    color: var(--color-text-muted);
  }
</style>
